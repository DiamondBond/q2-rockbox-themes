#
#- Sub Menu Initialisation -#
# Logic for rendering the main menus and header with page title. Broken down into the following:
# If not home menu, quickscreen, system info screen or usb screen then render header with page title.
# If page has one of the following numbers or titles then add the icon layout to the header if icons turned on.
# General menu declaration like the one used above for the home menu.
# If in the database, playlist menu (needs confirmation), or settings home screen, display icon menus if possible.
#
%?and(%if(%cs,!=,1),%if(%cs,!=,10),%if(%cs,!=,16),%if(%cs,!=,21))<%Vd(Sub_Menu_Header)%?or(%if(%cs,=,7),%if(%Li, =, 4),%if(%Li, =, 11),%if(%Li, =, 26),%if(%Li, =, 27),%if(%Li, =, 32),%and(%if(%cs, =, 15),%if(%Lt, !=, %Sx(Context Menu))),%if(%cs, =, 17),%if(%cs, =, 19),%if(%cs, =, 20),%if(%Lt,=,%Sx(Album Artist)),%if(%Lt,=,%Sx([All tracks])),%if(%Lt,=,%Sx([Untagged])),%if(%Lt,=,%Sx([By album])),%if(%Lt,=,%Sx(Artist)),%if(%Lt,=,%Sx(Album)),%if(%Lt,=,%Sx(Genre)),%if(%Lt,=,%Sx(Year)),%if(%Lt,=,%Sx(Composer)),%if(%Lt,=,%Sx(Tracks by)),%if(%Lt,=,%Sx(Search by...)),%if(%Lt,=,%Sx(User Rating)),%if(%Lt,=,%Sx(Recently Added)),%if(%Lt,=,%Sx(User Rating)),%if(%Lt,=,%Sx(Settings)),%if(%Lt,=,%Sx(Sound Settings)),%if(%Lt,=,%Sx(Playback Settings)),%if(%Lt,=,%Sx(General Settings)),%if(%Lt,=,%Sx(Database)),%if(%Lt,=,%Sx(Theme Settings)),%if(%Lt,=,%Sx(Recording Settings)),%if(%Lt,=,%Sx(Manage Settings)),%if(%Lt,=,%Sx(Main Menu)),%if(%Lt,=,%Sx(By First Letter...)),%if(%Lt,=,%Sx(Playback History)),%if(%Lt,=,%Sx(Same as currently played track)))<%?St(show icons)<%Vd(Header_with_Icon)|%Vd(Header_without_Icon)>|%Vd(Header_without_Icon)>%?and(%if(%ss(0,2,%St(font)),!=,22),%if(%ss(0,2,%St(font)),!=,24))<%VI(Sub_Menu_Viewport_Full)|%Vd(Sub_Menu_Corners)%?St(scrollbar)<%VI(Sub_Menu_Viewport_Full)|%VI(Sub_Menu_Viewport_Right)%?LB<%Vd(Scrollbar_Short_Left)>|%VI(Sub_Menu_Viewport_Left)%?LB<%Vd(Scrollbar_Short_Right)>>%?St(scrollbar)<%?or(%and(%if(%Lt,=,%Sx(Database)),%if(%Li,=,3)),%if(%Lt,=,%Sx(Settings)))<%?St(show icons)<%?Sr<%Lb(No_Scroll_Menu_With_Icons_RTL,213,40)|%Lb(No_Scroll_Menu_With_Icons_LTR,213,40)>|%Lb(No_Scroll_Menu_No_Icons,213,40)>|%Lb(No_Scroll_Menu_No_Icons,213,40)>|%?or(%and(%if(%Lt,=,%Sx(Database)),%if(%Li,=,3)),%if(%Lt,=,%Sx(Settings)),%if(%Lt,=,%Sx(Select one or more directories)))<%?St(show icons)<%?Sr<%Lb(Menu_With_Icons_RTL,213,40)|%Lb(Menu_With_Icons_LTR,213,40)>|%Lb(Menu_No_Icons,213,40)>|%Lb(Menu_No_Icons,213,40)>>>>
