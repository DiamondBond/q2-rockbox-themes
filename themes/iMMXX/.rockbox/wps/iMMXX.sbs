# iMMXX theme by FCorp
# a Frankenstein theme

# Modified/Derived from:
# PodTwo theme by Guillaume Cocatre-Zilgien
# &&
# iVideo theme by Humberto Santana
# &&
# Ash theme by Guillaume Cocatre-Zilgien <gcocatre@gmail.com>
# (http://creativecommons.org/licenses/by-sa/3.0/)

# Version 1.0
# First Version: April 2020

# Disable Status Bar
%wd

# Clear Backdrop
%X(d)

# Preload Font
%Fl(2,14-ChicagoFLF.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,5)
%xl(playmodes,playmodes.bmp,0,0,9)

# Menu
%Vi(-,22,67,331,185,-)

# Display Viewports
%?if(%mp, =, 1)<%?if(%bc, =, c)<%Vd(usb)|%?if(%bp, =, p)<%Vd(usb)|%Vd(playbackmode)>>|%Vd(playbackmode)>
%?if(%Lt, =, themes)<%Vd(themetitle)|%?if(%St(background color), =, 0000a5)<%?if(%St(foreground color), =, a5a6a5)<%Vd(msboxtitle)|%Vd(title)>|%?if(%St(background color), =, 0000A5)<%?if(%St(foreground color), =, A5A6A5)<%Vd(msboxtitle)|%Vd(title)>|%Vd(title)>>>
%?if(%St(battery display), =, numeric)<%Vd(batteryn)|%?if(%bc, =, c)<%Vd(batteryn)|%?if(%bp, =, p)<%Vd(batteryn)|%Vd(batteryg)>>>
%Vd(topbar)

# Playback stopped
%?if(%mp, =, 1)<%?if(%Lt, =, themes)<%Vd(arrows)%Vd(bootnote)|%Vd(date)>|>
# Playback not stopped, playing music
%?if(%mp, >, 1)<%?if(%mp, <=, 7)<%?if(%ig, =, Chamber Music)<%Vd(art)%Vd(artborder)%Vd(composer)%Vd(playbackmode)|%?if(%ig, =, Classical)<%Vd(art)%Vd(artborder)%Vd(composer)%Vd(playbackmode)|%?if(%ig, =, Opera)<%Vd(art)%Vd(artborder)%Vd(composer)%Vd(playbackmode)|%?if(%ig, =, Sonata)<%Vd(art)%Vd(artborder)%Vd(composer)%Vd(playbackmode)|%?if(%ig, =, Symphony)<%Vd(art)%Vd(artborder)%Vd(composer)%Vd(playbackmode)|%Vd(art)%Vd(artborder)%Vd(metadata)%Vd(playbackmode)>>>>>|>|>
# Playback not stopped, listening to the radio
%?if(%mp, >, 1)<%?if(%mp, >=, 8)<%Vd(arrows)%Vd(radio)|>|>
%Vd(bottombar)

# Playback Mode Icons
%Vl(playbackmode,28,36,14,15,-)
%xd(playmodes,%mp)

# USB
%Vl(usb,28,36,35,16,2)
%alUSB

# Menu Title
%Vl(title,63,36,249,16,2)
%ac%?if(%mh, =, h)<[ |>%?if(%lh, =, h)<…|>%?Lt<%Lt|Rockbox>%?if(%lh, =, h)<…|>%?if(%mh, =, h)< ]|>

# MS-BOX Menu Title
%Vl(msboxtitle,63,36,249,16,2)
%ac%?if(%mh, =, h)<[ |>%?if(%lh, =, h)<…|>%?Lt<%?if(%Lt, =, Rockbox)<MS-BOX|%Lt>|MS-BOX>%?if(%lh, =, h)<…|>%?if(%mh, =, h)< ]|>

# Theme Menu Title
%Vl(themetitle,63,36,249,16,2)
%ac%?if(%mh, =, h)<[ |>%?if(%lh, =, h)<…|>iMMXX%?if(%lh, =, h)<…|>%?if(%mh, =, h)< ]|>

# Battery (graphical)
%Vl(batteryg,321,36,26,14,-)
%?if(%bl, >, 88)<%xd(battery,5)|%?if(%bl, >, 63)<%xd(battery,4)|%?if(%bl, >, 38)<%xd(battery,3)|%?if(%bl, >, 13)<%xd(battery,2)|%xd(battery,1)>>>>

# Battery (numerical)
%Vl(batteryn,312,36,35,16,2)
%ar%bl%%

# Cover Art Border
%Vl(artborder,22,264,25,26,-)
%dr(0,0,25,25)

# Cover Artwork
%Vl(art,22,264,25,26,-)
%Cl(0,0,25,25,c,c)
%Cd

# Top Bar Separator Line
%Vl(topbar,22,56,331,2,-)
%dr(0,0,331,2)

# Bottom Bar Separator Line
%Vl(bottombar,22,262,331,2,-)
%dr(0,0,331,2)

# Song Metadata
%Vl(arrows,27,270,20,16,2)
%al%>%>

%Vl(metadata,47,270,281,16,2)
%s%ac%?it<“%it”|%fn>%?ia< by %ia|%?iA< by %iA|>>

%Vl(composer,47,270,281,16,2)
%s%ac%?it<“%it”|%fn>%?ic< by %ic|%?ia< by %ia|%?iA< by %iA|>>>

%Vl(arrows,333,270,20,16,2)
%al%<%<

# Radio Name and Frequency
%Vl(radio,47,270,281,16,2)
%s%ac %?Tn<%Tn %(%tf FM%)|%?ty<%ty %(%tf FM%)|FM Radio %(%tf MHz%)>>

# Date / Time
%Vl(date,28,270,319,16,2)
%al%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>, %?cm<January|February|March|April|May|June|July|August|September|October|November|December> %ce, %cY%ar%?cf<%cH:%cM|%cl:%cM %cP>

# Boot Note
# %Vl(bootnote,24,222,272,14,2)
# %s%ac by FCorp
