# iMMXX theme by FCorp
# a Frankenstein theme

# Modified/Derived from:
# PodTwo theme by Guillaume Cocatre-Zilgien
# &&
# iVideo theme by Humberto Santana
# &&
# Ash theme by Guillaume Cocatre-Zilgien <gcocatre@gmail.com>
# (http://creativecommons.org/licenses/by-sa/3.0/)

# Version 1.0
# First Version: April 2020

# Disable Status Bar
%wd

# Clear Backdrop
%X(d)

# Preload Font
%Fl(2,14-ChicagoFLF.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,5)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(pbbd,progressbar_backdrop.bmp,0,0)

# Display Viewports
%Vd(playbackmode)
%Vd(title)
%?if(%St(battery display), =, numeric)<%Vd(batteryn)|%?if(%bc, =, c)<%Vd(batteryn)|%?if(%bp, =, p)<%Vd(batteryn)|%Vd(batteryg)>>>
%Vd(topbar)
%Vd(metadata)
%Vd(artborder)
%Vd(coverart)

%?if(%St(background color), =, 0000a5)<%?if(%St(foreground color), =, a5a6a5)<%?mv<%Vd(volume)%Vd(volumebaryellow)|%Vd(freqpos)%Vd(freqbaryellow)>|%?mv<%Vd(volume)%Vd(volumebar)|%Vd(freqpos)%Vd(freqbar)>>|%?if(%St(background color), =, 0000A5)<%?if(%St(foreground color), =, A5A6A5)<%?mv<%Vd(volume)%Vd(volumebaryellow)|%Vd(freqpos)%Vd(freqbaryellow)>|%?mv<%Vd(volume)%Vd(volumebar)|%Vd(freqpos)%Vd(freqbar)>>|%?mv<%Vd(volume)%Vd(volumebar)|%Vd(freqpos)%Vd(freqbar)>>>

# Playback Mode Icons
%Vl(playbackmode,28,36,14,15,-)
%xd(playmodes,%mp)

# WPS Title
%Vl(title,63,36,249,16,2)
%ac%?if(%mh, =, h)<[ |>%?if(%lh, =, h)<…|>FM Radio%?if(%lh, =, h)<…|>%?if(%mh, =, h)< ]|>

# Cover Art Border
%Vl(artborder,36,95,102,106,-)
%dr(0,0,101,101)

# Cover Artwork
%Vl(coverart,36,95,102,106,-)
%Cl(0,0,99,99,c,c)
%Cd

# Battery (graphical)
%Vl(batteryg,321,36,26,14,-)
%?if(%bl, >, 88)<%xd(battery,5)|%?if(%bl, >, 63)<%xd(battery,4)|%?if(%bl, >, 38)<%xd(battery,3)|%?if(%bl, >, 13)<%xd(battery,2)|%xd(battery,1)>>>>

# Battery (numerical)
%Vl(batteryn,312,36,35,16,2)
%ar%bl%%

# Top Bar Separator Line
%Vl(topbar,22,56,331,2,-)
%dr(0,0,331,2)

# Preset and Frequency
%Vl(metadata,36,71,102,15,2)
%s%al%?Ti<Preset %Ti of %Tc|%tf MHz>

# Preset Name or RDS Name
%Vl(metadata,147,96,200,21,-)
%s%al%?Tn<%Tn|%?ty<%ty|FM Radio>>

# RDS Text
%Vl(metadata,147,123,200,21,-)
%s%al%?tz<%tz|No RDS Data>

# Signal Strength
%Vl(metadata,147,150,200,21,-)
%s%al%?tr<Weak|Good|Strong|Strong> Signal

# Mono / Stereo
%Vl(metadata,147,177,200,21,-)
%s%al%?ts<Stereo|Mono>

# Min / Max Frequencies
%Vl(freqpos,28,256,319,16,2)
%al%ta%ac%tf%ar%tb

# Volume
%Vl(volume,28,256,319,16,2)
%acVolume: %?if(%pv, >, 0)<+|>%pv dB%?if(%pv, >, 0)< %(warning: may clip%)|%?if(%pv, =, 0)< %(maximum%)|>>

# Frequency Bar
%Vl(freqbar,28,225,319,26,-)
%pb(0,0,319,25,progressbar.bmp,backdrop,pbbd)

# Volume Bar
%Vl(volumebar,28,225,319,26,-)
%pv(0,0,319,25,progressbar.bmp,backdrop,pbbd)

# Frequency Bar (MSBOX)
%Vl(freqbaryellow,28,225,319,26,-)
%pb(0,0,319,25,progressbar-yellow.bmp,backdrop,pbbd)

# Volume Bar (MSBOX)
%Vl(volumebaryellow,28,225,319,26,-)
%pv(0,0,319,25,progressbar-yellow.bmp,backdrop,pbbd)
