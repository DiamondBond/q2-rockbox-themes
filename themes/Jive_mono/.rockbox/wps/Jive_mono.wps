%Vl(mainDisplay,262,67,77,77,-)
%?px<%xd(Progressa)|%xd(Progressb)|%xd(Progressc)|%xd(Progressd)|%xd(Progresse)|%xd(Progressf)|%xd(Progressg)|%xd(Progressh)|%xd(Progressi)|%xd(Progressj)|%xd(Progressk)|%xd(Progressl)|%xd(Progressm)|%xd(Progressn)|%xd(Progresso)|%xd(Progressp)|%xd(Progressq)|%xd(Progressr)|%xd(Progresss)|%xd(Progresst)|%xd(Progressu)|%xd(Progressv)|%xd(Progressw)|%xd(Progressx)|%xd(Progressy)|%xd(Progressz)|%xd(Progress0)|%xd(Progress1)|%xd(Progress2)|%xd(Progress3)|%xd(Progress4)|%xd(Progress5)|%xd(Progress6)|%xd(Progress7)|%xd(Progress8)|%xd(Progress9)|%xd(Progress10)>

