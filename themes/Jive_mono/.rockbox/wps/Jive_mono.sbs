###############################################################
#
# SBS File
#
#-- Hide The Status Bar
%wd
#
#-- Title Bar Disabler
%?Lt<|>
#
#-- Backdrop
%X(Background_SBS.bmp) 
#
#-- PreLoad Fonts
%Fl(2,14-MPLUSRounded1c-Medium.fnt)
%Fl(4,16-MPLUSRounded1c-Medium.fnt)
%Fl(6,20-MPLUSRounded1c-Medium.fnt)
#
#-- Preloaded Images
%xl(B,disk.bmp,0,0,6)
%xl(H,status.bmp,0,0,4)
%xl(I,usb.bmp,0,0)
%xl(O,hold.bmp,0,0)
#
#
##############
# STATUS BAR #
##############
#
#-- Status icons
%V(28,29,27,17,-)%Vf(ffffff)%Vb(F4F4F4)
%?mp<|%xd(Hb)|%xd(Ha)|%xd(Hc)|%xd(Hd)||||>
#
#-- Hold icon
%V(60,29,15,17,-)%Vf(ffffff)%Vb(F4F4F4)
%?mh<%xd(O)|%?mr<%xd(O)>>
#
#-- Status title
%V(107,29,161,18,2)%Vf(ffffff)%Vb(F4F4F4)
%ac%cb %ce%, %?cf<%cH:%cM|%cl:%cM %cP>
%s%ac%?cs<%?cf<%cH:%cM|%cl:%cM %cP>|Now Playing|Recording|Radio|Playlist|Settings|Browser|Database|Plugins|Quickscreen|Pitchscreen|Settings|Playlists|Plugin|Context|System|Date/Time|Bookmark|Shortcuts|Info|USB Connected>
#
#-- Battery icon top right
%V(312,29,36,17,2)%Vf(ffffff)
%ar%bl%%

###########
# CONTENT #
###########
#
# 	Display bar on bottom with album art, track info or volume indicator as necessary
%?mp<|%?C<%Vd(albumart)%Vd(currenttrack)|%Vd(currenttrackshiftedleft)>|%?C<%Vd(albumart)%Vd(currenttrack)|%Vd(currenttrackshiftedleft)>>
#
# 	Set up UI Viewport 
# 	Use larger viewport if nothing is playing
%?mp<%VI(mainlarge)|%VI(main)|%VI(main)>
#
#	Smaller viewport to make room for larger bar on bottom
%Vi(main,22,58,331,192,4)%Vf(ffffff)%Vb(F4F4F4)
#
#	Larger Viewport if nothing is playing
%Vi(mainlarge,22,58,331,232,4)%Vf(ffffff)%Vb(F4F4F4)
#
#	USB screen
#%V(0,0,320,240,-)%Vf(ffffff)%Vb(F4F4F4)
#%?if(%cs, =, 21)<%xd(I)>
#
#-- Track background
#%Vl(trackbg,0,208,320,32,-)%Vf(ffffff)%Vb(F4F4F4)
#%xd(A)
#
#
# 	Album Art
%Vl(albumart,34,255,35,35,-)%Vf(ffffff)%Vb(F4F4F4)
%Cl(0,0,34,34)%Vf(ffffff)%Vb(F4F4F4)
%Cd
#
#	Current Track
%Vl(currenttrack,78,263,262,30,2)%Vf(ffffff)%Vb(F4F4F4)
%al%?ia<%it — |>%?it<%ia|%fn>#
#	Current Track shifted left
%Vl(currenttrackshiftedleft,34,263,306,30,2)%Vf(ffffff)%Vb(F4F4F4)
%al%?ia<%it — |>%?it<%ia|%fn>