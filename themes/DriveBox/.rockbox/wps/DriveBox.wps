#
# Versions
# 1.1    22/12/2010
#        Totally rewriten to the new syntax.
#        Fixed progress bar (Thanks to spike66 of Rockbox Technical Forums)
# 1.0 r3 22/03/2009 10:44:55


# Remove upper standard status bar
%wd

#-------------------------------------
# Background
%X(bg.bmp)


#--------------------------
# Image definitions

# Battery (Mapped type, 18 images in the file)
%xl(B,batteryM.bmp,234,224,18)
%?bp<%xd(Ba)|%?bl<%xd(Br)|%xd(Br)|%xd(Bq)|%xd(Bp)|%xd(Bo)|%xd(Bn)|%xd(Bm)|%xd(Bl)|%xd(Bj)|%xd(Bj)|%xd(Bi)|%xd(Bh)|%xd(Bg)|%xd(Bf)|%xd(Be)|%xd(Bd)|%xd(Bc)|%xd(Bb)>>

# Volume (Mapped type, 8 images in the file)
%xl(V,volM.bmp,347,0,8)
%?pv<%xd(Vh)|%xd(Vh)|%xd(Vh)|%xd(Vh)|%xd(Vh)|%xd(Vh)|%xd(Vh)|%xd(Vh)|%xd(Vh)|%xd(Vg)|%xd(Vg)|%xd(Vg)|%xd(Vg)|%xd(Vg)|%xd(Vf)|%xd(Vf)|%xd(Vf)|%xd(Vf)|%xd(Ve)|%xd(Ve)|%xd(Vd)|%xd(Vd)|%xd(Vc)|%xd(Vb)|%xd(Va)>

# Shuffle
%xl(S,shuffle.bmp,279,183)
%?ps<%xd(S)>

# Repeat
%xl(R,repeatM.bmp,279,201,5)
%?mm<%xd(Ra)|%xd(Rc)|%xd(Rb)|%xd(Re)|%xd(Rd)>

# Play controls  (Mapped type, 5 images in the file)
%xl(P,playbackM.bmp,234,153,5)
%?mp<%xd(Pa)|%xd(Pb)|%xd(Pc)|%xd(Pd)|%xd(Pe)>

# HDD spin
%xl(H,hdd.bmp,279,224)
%?lh<%xd(H)>

# Hold
%xl(L,lock.bmp,234,183)
%?mh<%xd(L)>
%xl(M,lock.bmp,234,183)
%?mr<%xd(M)>


# Album Art preload
%Cl(0,0,234,267)




#------------------------------------
# ViewPorts
#------------------------------------

# Progress Bar (Fixed thanks to spike66 of Rockbox Technical Forums)
%V(232,132,141,21,-)
%pb(0,0,-,-,pb.bmp)

# Song Artist
%V(0,0,328,27,1)
%Vf(d0d0d0) 
%al%?ia<%ia|%d(2)>

# Song Title
%V(0,27,375,27,1)
%Vf(ffffff) 
%al%s%?it<%it|%fn>

# Volume
%V(315,23,32,23,1)
%Vf(5f8cad) 
%ar%pv


# Total Lenght, year and album position
%V(238,85,135,13,0)
%Vf(808080) 
%al%pt%ac%iy%ar%pp/%pe
# Album name
%V(232,65,139,13,0)
%Vf(b0b0b0)
%ac%?id<%id|%d(1)>
# Style (Disabled)
# %V(201,70,119,10,0)
# %Vf(000000) 
# %ar%ig


# Timings
%V(238,108,135,23,1)
%Vf(5f8cad) 
%al%pc%ar-%pr


# Tech info
%V(198,279,139,27,0)
%Vf(000000) 
%ac%fbKbps %?fv<VBR|CBR> %?fc<mp1|mp2|mp3|AIFF|wav|vorbis|flac|mpc|a52|wavpack|alac|aac|shorten|SID|ADX|NSF|speex|SPC|APE|WMA|unknown>

# DateTime
%V(169,304,139,13,0)
%Vf(101010) 
%al%ca %ce/%cm/%cy
%V(242,295,54,23,1)
%Vf(0a0a0a) 
%ar%cH:%cM


#Album Art display
%V(0,53,234,267,0)
%Cd

# End :)