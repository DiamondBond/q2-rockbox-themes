# Theme: DAP-393
# Version 1.0
# Last Update: 17/07/2026 (DD/MM/YYYY)
# License: CC-BY-SA 3.0
# A 360ad theme
# Created during July, 2026
# All assets drawn by me in Photoshop.
# Absolutely NO AI has been used during the creation of this theme.
#
%Fl(2,6-DAP393.fnt)
%wd
%X(/.rockbox/backdrops/393WPS.bmp)
%Vd(volume_dial)
%Vd(audio_bars)
%Vd(codec_display)
%Vd(shuffle_display)
%Vd(true_shuffle_display)
%Vd(lock_display)
%Vd(playmode_display)
%Vd(track_title_display)
%Vd(album_display)
%Vd(artist_display)
%Vd(bitrate_display)
%Vd(track_number_display)
%Vd(playlist_total_display)
%?if(%pr, <, 600)<%Vd(time_m_ss)|%?if(%pr, <, 3600)<%Vd(time_mm_ss)|%?if(%pr, <, 36000)<%Vd(time_h_mm_ss)|%Vd(time_hh_mm_ss)>>>
#
#
#
# This is the track number indicator. To be totally honest, as of writing this I don't know what happens if you
# go over 9999 tracks in a playlist. It may eff it up. It works at least till 9999 tracks.
# Each number is drawn individually from a file with numbers in it. 
# They were custom drawn by me (this was BEFORE I made the DAP393 font to be used with the theme, so I was using
# primitive methods. Bonus though, is that these (since they're images) can have an outer glow. neat!
# It also renders NO leading zeros. We don't need'em!
#
%Vl(track_number_display,0,0,375,320,1)
%Vb(-)
%xl(S,number.bmp,159,124,10)
%xl(T,number.bmp,163,124,10)
%xl(U,number.bmp,167,124,10)
%xl(V,number.bmp,171,124,10)
%?if(%pp, >, 999)<%?ss(0,1,%pp,number)<%xd(S)|%xd(S,2)|%xd(S,3)|%xd(S,4)|%xd(S,5)|%xd(S,6)|%xd(S,7)|%xd(S,8)|%xd(S,9)|%xd(S,10)>|>
%?if(%pp, >, 999)<%?ss(1,1,%pp,number)<%xd(T)|%xd(T,2)|%xd(T,3)|%xd(T,4)|%xd(T,5)|%xd(T,6)|%xd(T,7)|%xd(T,8)|%xd(T,9)|%xd(T,10)>|%?if(%pp, >, 99)<%?ss(0,1,%pp,number)<%xd(T)|%xd(T,2)|%xd(T,3)|%xd(T,4)|%xd(T,5)|%xd(T,6)|%xd(T,7)|%xd(T,8)|%xd(T,9)|%xd(T,10)>|>>
%?if(%pp, >, 999)<%?ss(2,1,%pp,number)<%xd(U)|%xd(U,2)|%xd(U,3)|%xd(U,4)|%xd(U,5)|%xd(U,6)|%xd(U,7)|%xd(U,8)|%xd(U,9)|%xd(U,10)>|%?if(%pp, >, 99)<%?ss(1,1,%pp,number)<%xd(U)|%xd(U,2)|%xd(U,3)|%xd(U,4)|%xd(U,5)|%xd(U,6)|%xd(U,7)|%xd(U,8)|%xd(U,9)|%xd(U,10)>|%?if(%pp, >, 9)<%?ss(0,1,%pp,number)<%xd(U)|%xd(U,2)|%xd(U,3)|%xd(U,4)|%xd(U,5)|%xd(U,6)|%xd(U,7)|%xd(U,8)|%xd(U,9)|%xd(U,10)>|>>>
%?if(%pp, >, 999)<%?ss(3,1,%pp,number)<%xd(V)|%xd(V,2)|%xd(V,3)|%xd(V,4)|%xd(V,5)|%xd(V,6)|%xd(V,7)|%xd(V,8)|%xd(V,9)|%xd(V,10)>|%?if(%pp, >, 99)<%?ss(2,1,%pp,number)<%xd(V)|%xd(V,2)|%xd(V,3)|%xd(V,4)|%xd(V,5)|%xd(V,6)|%xd(V,7)|%xd(V,8)|%xd(V,9)|%xd(V,10)>|%?if(%pp, >, 9)<%?ss(1,1,%pp,number)<%xd(V)|%xd(V,2)|%xd(V,3)|%xd(V,4)|%xd(V,5)|%xd(V,6)|%xd(V,7)|%xd(V,8)|%xd(V,9)|%xd(V,10)>|%?ss(0,1,%pp,number)<%xd(V)|%xd(V,2)|%xd(V,3)|%xd(V,4)|%xd(V,5)|%xd(V,6)|%xd(V,7)|%xd(V,8)|%xd(V,9)|%xd(V,10)>>>>
#
%Vl(playlist_total_display,0,0,375,320,1)
%Vb(-)
%xl(W,number.bmp,183,124,10)
%xl(X,number.bmp,188,124,10)
%xl(Y,number.bmp,192,124,10)
%xl(Z,number.bmp,196,124,10)
%?if(%pe, >, 999)<%?ss(0,1,%pe,number)<%xd(W)|%xd(W,2)|%xd(W,3)|%xd(W,4)|%xd(W,5)|%xd(W,6)|%xd(W,7)|%xd(W,8)|%xd(W,9)|%xd(W,10)>|>
%?if(%pe, >, 999)<%?ss(1,1,%pe,number)<%xd(X)|%xd(X,2)|%xd(X,3)|%xd(X,4)|%xd(X,5)|%xd(X,6)|%xd(X,7)|%xd(X,8)|%xd(X,9)|%xd(X,10)>|%?if(%pe, >, 99)<%?ss(0,1,%pe,number)<%xd(X)|%xd(X,2)|%xd(X,3)|%xd(X,4)|%xd(X,5)|%xd(X,6)|%xd(X,7)|%xd(X,8)|%xd(X,9)|%xd(X,10)>|>>
%?if(%pe, >, 999)<%?ss(2,1,%pe,number)<%xd(Y)|%xd(Y,2)|%xd(Y,3)|%xd(Y,4)|%xd(Y,5)|%xd(Y,6)|%xd(Y,7)|%xd(Y,8)|%xd(Y,9)|%xd(Y,10)>|%?if(%pe, >, 99)<%?ss(1,1,%pe,number)<%xd(Y)|%xd(Y,2)|%xd(Y,3)|%xd(Y,4)|%xd(Y,5)|%xd(Y,6)|%xd(Y,7)|%xd(Y,8)|%xd(Y,9)|%xd(Y,10)>|%?if(%pe, >, 9)<%?ss(0,1,%pe,number)<%xd(Y)|%xd(Y,2)|%xd(Y,3)|%xd(Y,4)|%xd(Y,5)|%xd(Y,6)|%xd(Y,7)|%xd(Y,8)|%xd(Y,9)|%xd(Y,10)>|>>>
%?if(%pe, >, 999)<%?ss(3,1,%pe,number)<%xd(Z)|%xd(Z,2)|%xd(Z,3)|%xd(Z,4)|%xd(Z,5)|%xd(Z,6)|%xd(Z,7)|%xd(Z,8)|%xd(Z,9)|%xd(Z,10)>|%?if(%pe, >, 99)<%?ss(2,1,%pe,number)<%xd(Z)|%xd(Z,2)|%xd(Z,3)|%xd(Z,4)|%xd(Z,5)|%xd(Z,6)|%xd(Z,7)|%xd(Z,8)|%xd(Z,9)|%xd(Z,10)>|%?if(%pe, >, 9)<%?ss(1,1,%pe,number)<%xd(Z)|%xd(Z,2)|%xd(Z,3)|%xd(Z,4)|%xd(Z,5)|%xd(Z,6)|%xd(Z,7)|%xd(Z,8)|%xd(Z,9)|%xd(Z,10)>|%?ss(0,1,%pe,number)<%xd(Z)|%xd(Z,2)|%xd(Z,3)|%xd(Z,4)|%xd(Z,5)|%xd(Z,6)|%xd(Z,7)|%xd(Z,8)|%xd(Z,9)|%xd(Z,10)>>>>
#
#
# This bit shows the codec. Well, at least 4 of them.
# My most used codecs are FLAC and MP3.
# Music from iTunes will be in AAC, so that's there too.
# And WAV, because why not. 
# Anything else is 'OTHER'.
#
%Vl(codec_display,0,0,375,320,1)
%Vb(-)
%xl(M,codecs.bmp,249,122,5)
%?fc<%xd(M,5)|%xd(M,5)|%xd(M,1)|%xd(M,5)|%xd(M,4)|%xd(M,5)|%xd(M,2)|%xd(M,5)|%xd(M,5)|%xd(M,5)|%xd(M,5)|%xd(M,3)|%xd(M,5)|%xd(M,5)|%xd(M,5)|%xd(M,5)|%xd(M,5)|%xd(M,5)|%xd(M,5)|%xd(M,5)>
#
#
# Don't be fooled, I called this section the 'SHUFFLE' display because I didn't realise that the shuffle option
# within the repeat settings was its own thing, and NOT the same thing as the shuffle option.
# So the real shuffle is called REALshuffle or a biosimilar.
#
# Anyhows this is the REPEAT display. When off, the button is unpressed and the OFF light is red.
# When an option is enabled, it gets lit up, and the button gets pushed.
#
%Vl(shuffle_display,0,0,375,320,1)
%Vb(-)
%xl(R,shuffle.bmp,260,172,5)
%?mm<%xd(R)|%xd(R,2)|%xd(R,3)|%xd(R,4)|%xd(R,5)>
#
#
# And yup, here's the true shuffle. Just a little icon that I drew.
# In FACT, you might even miss it. It comes on just after the red '8' at the peak end of the visualiser.
# On the actual KX-393 deck, this is a + sign (so you know if it reaches that, your audio is clipping.)
#
%Vl(true_shuffle_display,0,0,375,320,1)
%Vb(-)
%xl(I,trueshuffle.bmp,326,88,2)
%?ps<%xd(I,2)|%xd(I)>
#
#
# Here's the playmode thing. It's the big four buttons on the left.
# On the actual deck, the top two buttons are the same, but the bottom half is for the Intro Scan.
# It's a pretty neat bit of old tech that FFs through your tape to find when a new track comes on,
# then it rewinds to 5s before the track and plays. It's so cool.
# Unfortunately, rockbox don't do dat, so it's just a boring rewind and fast forward display (boo)
#
# All the icons light up when pressed, and the actual buttons get pushed down.
#
%Vl(playmode_display,0,0,375,320,1)
%Vb(-)
%xl(b,playmodes.bmp,29,161,4)
%?mp<%xd(b)|%xd(b,2)|%xd(b)|%xd(b,4)|%xd(b,3)>
#
#
# This is the lock button. 
# Same sitch as the repeat button, but with only OFF/ON.
#
%Vl(lock_display,0,0,375,320,1)
%Vb(-)
%xl(a,lock.bmp,272,228,2)
%?mh<%xd(a,2)|%xd(a)>
#
#
# This is similar to the track number display, but for the bitrate.
# Looks very kewl. The 'kbps' is baked into the WPS backdrop as it doesn't need to be rendered.
#
%Vl(bitrate_display,0,0,375,320,1)
%Vb(-)
%xl(Q,number.bmp,208,124,10)
%xl(P,number.bmp,212,124,10)
%xl(O,number.bmp,216,124,10)
%xl(N,number.bmp,221,124,10)
#
%?if(%fb, >, 999)<%?ss(0,1,%fb,number)<%xd(Q)|%xd(Q,2)|%xd(Q,3)|%xd(Q,4)|%xd(Q,5)|%xd(Q,6)|%xd(Q,7)|%xd(Q,8)|%xd(Q,9)|%xd(Q,10)>|>
%?if(%fb, >, 999)<%?ss(1,1,%fb,number)<%xd(P)|%xd(P,2)|%xd(P,3)|%xd(P,4)|%xd(P,5)|%xd(P,6)|%xd(P,7)|%xd(P,8)|%xd(P,9)|%xd(P,10)>|%?if(%fb, >, 99)<%?ss(0,1,%fb,number)<%xd(P)|%xd(P,2)|%xd(P,3)|%xd(P,4)|%xd(P,5)|%xd(P,6)|%xd(P,7)|%xd(P,8)|%xd(P,9)|%xd(P,10)>|>>
%?if(%fb, >, 999)<%?ss(2,1,%fb,number)<%xd(O)|%xd(O,2)|%xd(O,3)|%xd(O,4)|%xd(O,5)|%xd(O,6)|%xd(O,7)|%xd(O,8)|%xd(O,9)|%xd(O,10)>|%?if(%fb, >, 99)<%?ss(1,1,%fb,number)<%xd(O)|%xd(O,2)|%xd(O,3)|%xd(O,4)|%xd(O,5)|%xd(O,6)|%xd(O,7)|%xd(O,8)|%xd(O,9)|%xd(O,10)>|%?if(%fb, >, 9)<%?ss(0,1,%fb,number)<%xd(O)|%xd(O,2)|%xd(O,3)|%xd(O,4)|%xd(O,5)|%xd(O,6)|%xd(O,7)|%xd(O,8)|%xd(O,9)|%xd(O,10)>|>>>
%?if(%fb, >, 999)<%?ss(3,1,%fb,number)<%xd(N)|%xd(N,2)|%xd(N,3)|%xd(N,4)|%xd(N,5)|%xd(N,6)|%xd(N,7)|%xd(N,8)|%xd(N,9)|%xd(N,10)>|%?if(%fb, >, 99)<%?ss(2,1,%fb,number)<%xd(N)|%xd(N,2)|%xd(N,3)|%xd(N,4)|%xd(N,5)|%xd(N,6)|%xd(N,7)|%xd(N,8)|%xd(N,9)|%xd(N,10)>|%?if(%fb, >, 9)<%?ss(1,1,%fb,number)<%xd(N)|%xd(N,2)|%xd(N,3)|%xd(N,4)|%xd(N,5)|%xd(N,6)|%xd(N,7)|%xd(N,8)|%xd(N,9)|%xd(N,10)>|%?ss(0,1,%fb,number)<%xd(N)|%xd(N,2)|%xd(N,3)|%xd(N,4)|%xd(N,5)|%xd(N,6)|%xd(N,7)|%xd(N,8)|%xd(N,9)|%xd(N,10)>>>>
#
#
# Audio levels. Based DIRECTLY off the original deck. The original did have more levels like 17, 10 and a few more down
# the red end. I had to shorten it a bit to get it to work and look like on a tiny display. I wish I could attach photos
# of my deck here, it's so nice. Nice enough that I've made a whole theme based around it...
#
# Anyways, the code really didn't like that I was using multiple images instead of an on/off image thing. This is because
# the real deck doesn't move neatly, the individual 'nodes' go all or nothing, which technically doesn't look as nice as 
# if it used every individual line, but I wanted accuracy goddamnit!
#
# Long story short the image files that it reads from are in a weird layout. Maybe don't copy it? Do whatever. CC 3.0 or something.
#
%Vl(audio_bars,0,0,375,320,1)
%Vb(-)
%xl(K,leftbar.bmp,126,68,13)
%xl(L,rightbar.bmp,126,99,13)
%?mp<|%?pL<%xd(K,1)|%xd(K,2)|%xd(K,3)|%xd(K,4)|%xd(K,5)|%xd(K,6)|%xd(K,7)|%xd(K,8)|%xd(K,9)|%xd(K,10)|%xd(K,11)|%xd(K,12)|%xd(K,13)>|||>
%?mp<|%?pR<%xd(L,1)|%xd(L,2)|%xd(L,3)|%xd(L,4)|%xd(L,5)|%xd(L,6)|%xd(L,7)|%xd(L,8)|%xd(L,9)|%xd(L,10)|%xd(L,11)|%xd(L,12)|%xd(L,13)>|||>
#
#
# The volume dial a.k.a the bane of my existence. It spins!
# I can't get it to look better than this, this is actually how the dials look on the player. 
# It maxes out at 0dB althought rockbox will continue to increase the volume after this.
# Even with some decent headphones I don't ever get close to 0dB so this shouldn't be an issue.
# Think of it as a feature!
#
%Vl(volume_dial,0,0,375,320,1)
%Vb(-)
%xl(J,dial.bmp,195,195,85)
%?pv<%xd(J,1)|%xd(J,2)|%xd(J,3)|%xd(J,4)|%xd(J,5)|%xd(J,6)|%xd(J,7)|%xd(J,8)|%xd(J,9)|%xd(J,10)|%xd(J,11)|%xd(J,12)|%xd(J,13)|%xd(J,14)|%xd(J,15)|%xd(J,16)|%xd(J,17)|%xd(J,18)|%xd(J,19)|%xd(J,20)|%xd(J,21)|%xd(J,22)|%xd(J,23)|%xd(J,24)|%xd(J,25)|%xd(J,26)|%xd(J,27)|%xd(J,28)|%xd(J,29)|%xd(J,30)|%xd(J,31)|%xd(J,32)|%xd(J,33)|%xd(J,34)|%xd(J,35)|%xd(J,36)|%xd(J,37)|%xd(J,38)|%xd(J,39)|%xd(J,40)|%xd(J,41)|%xd(J,42)|%xd(J,43)|%xd(J,44)|%xd(J,45)|%xd(J,46)|%xd(J,47)|%xd(J,48)|%xd(J,49)|%xd(J,50)|%xd(J,51)|%xd(J,52)|%xd(J,53)|%xd(J,54)|%xd(J,55)|%xd(J,56)|%xd(J,57)|%xd(J,58)|%xd(J,59)|%xd(J,60)|%xd(J,61)|%xd(J,62)|%xd(J,63)|%xd(J,64)|%xd(J,65)|%xd(J,66)|%xd(J,67)|%xd(J,68)|%xd(J,69)|%xd(J,70)|%xd(J,71)|%xd(J,72)|%xd(J,73)|%xd(J,74)|%xd(J,75)|%xd(J,76)|%xd(J,77)|%xd(J,78)|%xd(J,79)|%xd(J,80)|%xd(J,81)|%xd(J,82)|%xd(J,83)|%xd(J,84)|%xd(J,85)>
