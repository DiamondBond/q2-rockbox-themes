%Vb(-)
%xl(C,numbers.bmp,39,69,100)
%xl(D,numbers.bmp,71,69,100)
%?ss(0,2,%pr,number)<%xd(C)|%xd(C,2)|%xd(C,3)|%xd(C,4)|%xd(C,5)|%xd(C,6)|%xd(C,7)|%xd(C,8)|%xd(C,9)|%xd(C,10)|%xd(C,11)|%xd(C,12)|%xd(C,13)|%xd(C,14)|%xd(C,15)|%xd(C,16)|%xd(C,17)|%xd(C,18)|%xd(C,19)|%xd(C,20)|%xd(C,21)|%xd(C,22)|%xd(C,23)|%xd(C,24)|%xd(C,25)|%xd(C,26)|%xd(C,27)|%xd(C,28)|%xd(C,29)|%xd(C,30)|%xd(C,31)|%xd(C,32)|%xd(C,33)|%xd(C,34)|%xd(C,35)|%xd(C,36)|%xd(C,37)|%xd(C,38)|%xd(C,39)|%xd(C,40)|%xd(C,41)|%xd(C,42)|%xd(C,43)|%xd(C,44)|%xd(C,45)|%xd(C,46)|%xd(C,47)|%xd(C,48)|%xd(C,49)|%xd(C,50)|%xd(C,51)|%xd(C,52)|%xd(C,53)|%xd(C,54)|%xd(C,55)|%xd(C,56)|%xd(C,57)|%xd(C,58)|%xd(C,59)|%xd(C,60)>
