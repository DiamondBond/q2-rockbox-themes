%wd
%Fl(3,18-Cantarell-Regular.fnt)
%Fl(4,18-Cantarell-Bold.fnt)
%Fl(5,20-Cantarell-Regular.fnt)
%Fl(6,20-Cantarell-Bold.fnt)
#-- Icons --#
%xl(SleepIcon,SleepStatus.bmp,2,1)
%xl(HoldIcon,HoldStatus.bmp,2,1)
%xl(L,LoadingStatus.bmp,12)
%xl(BatteryIcon,BatteryStatus.bmp,12)
%xl(ChargingIcon,ChargeStatus.bmp,11)
%xl(ShuffleIcon,ShuffleStatus.bmp,2)
%xl(RepeatIcon,RepeatStatus.bmp,5)
#-- Album Art --#
%xl(CoverArtMask,CoverArtMask.bmp)
%xl(Fallback1,amber-d.bmp,22,62)
%xl(Fallback2,fold-d.bmp,22,62)
%xl(Fallback3,glass-chip-l.bmp,22,62)
%xl(Fallback4,pixel-pusher-d.bmp,22,62)
%xl(Fallback5,sheet-d.bmp,22,62)
#-- Player UI --#
%xl(PlayIcon,PlayIcon.bmp,5)
%xl(PlaylistPositionIcon,PlaylistPositionIndicators.bmp,4)
#-- Volume Slider --#
%xl(VolumeIcons,VolumeIcons.bmp,4)
#-- Circular Progress Bar --#
%xl(Progressa,Playhead0.bmp)
%xl(Progressb,Playhead5.bmp)
%xl(Progressc,Playhead10.bmp)
%xl(Progressd,Playhead15.bmp)
%xl(Progresse,Playhead20.bmp)
%xl(Progressf,Playhead25.bmp)
%xl(Progressg,Playhead30.bmp)
%xl(Progressh,Playhead35.bmp)
%xl(Progressi,Playhead40.bmp)
%xl(Progressj,Playhead45.bmp)
%xl(Progressk,Playhead50.bmp)
%xl(Progressl,Playhead55.bmp)
%xl(Progressm,Playhead60.bmp)
%xl(Progressn,Playhead65.bmp)
%xl(Progresso,Playhead70.bmp)
%xl(Progressp,Playhead75.bmp)
%xl(Progressq,Playhead80.bmp)
%xl(Progressr,Playhead85.bmp)
%xl(Progresss,Playhead90.bmp)
%xl(Progresst,Playhead95.bmp)
%xl(Progressu,PlayheadFull.bmp)
#
#------------ Background Layer ------------#
%V(0,0,375,320,-)%VB
%Cl(-19,62,207,207)
%dr(0,134,375,186,424142)%Cd%?C<|%?ss(-1,1,%pt,number)<%xd(Fallback1)|%xd(Fallback2)|%xd(Fallback3)|%xd(Fallback4)|%xd(Fallback5)|%xd(Fallback1)|%xd(Fallback2)|%xd(Fallback3)|%xd(Fallback4)|%xd(Fallback5)>>

#
#------------ Foreground Layer ------------#
%V(0,0,375,320,-)
#-- Refresh Song info after volume pop-up --#
%Vd(Player)%Vd(titlesingle)
#
#-- Clock --#
%Vl(Player,146,32,83,20,4)%ac%?cf<%cH:%cM|%cl:%cM %cP>
#
#-- Icon Stuff --#
%Vl(Player,335,34,15,18,-)%?bp<%xd(ChargingIcon,%bl)|%xd(BatteryIcon,%bl)>
%Vl(Player,315,34,16,18,-)%?mh<%xd(HoldIcon,%mh)|%xd(SleepIcon,%bs)>
#
%Vl(Player,315,34,16,18,-)
%?mh<%xd(HoldIcon,%mh)|%?bs<%xd(SleepIcon)|%?lh<%t(0.1)%xd(La);%t(0.1)%xd(Lb);%t(0.1)%xd(Lc);%t(0.1)%xd(Ld);%t(0.1)%xd(Le);%t(0.1)%xd(Lf);%t(0.1)%xd(Lg);%t(0.1)%xd(Lh);%t(0.1)%xd(Li);%t(0.1)%xd(Lj);%t(0.1)%xd(Lk);%t(0.1)%xd(Ll)>>>
%Vl(Player,294,34,17,18,-)
%?mh<%?bs<%xd(SleepIcon)|%?lh<%t(0.1)%xd(La);%t(0.1)%xd(Lb);%t(0.1)%xd(Lc);%t(0.1)%xd(Ld);%t(0.1)%xd(Le);%t(0.1)%xd(Lf);%t(0.1)%xd(Lg);%t(0.1)%xd(Lh);%t(0.1)%xd(Li);%t(0.1)%xd(Lj);%t(0.1)%xd(Lk);%t(0.1)%xd(Ll)>|%?bs<%t(0.1)%xd(La);%t(0.1)%xd(Lb);%t(0.1)%xd(Lc);%t(0.1)%xd(Ld);%t(0.1)%xd(Le);%t(0.1)%xd(Lf);%t(0.1)%xd(Lg);%t(0.1)%xd(Lh);%t(0.1)%xd(Li);%t(0.1)%xd(Lj);%t(0.1)%xd(Lk);%t(0.1)%xd(Ll)>>>
%Vl(Player,273,34,17,18,-)
%?mh<%?bs<%?lh<%t(0.1)%xd(La);%t(0.1)%xd(Lb);%t(0.1)%xd(Lc);%t(0.1)%xd(Ld);%t(0.1)%xd(Le);%t(0.1)%xd(Lf);%t(0.1)%xd(Lg);%t(0.1)%xd(Lh);%t(0.1)%xd(Li);%t(0.1)%xd(Lj);%t(0.1)%xd(Lk);%t(0.1)%xd(Ll)>>>
#
#-- Album Art --#
%Vl(Player,0,62,188,217,-)
%xd(CoverArtMask)

#-- Progress Bar --#
%Vl(Player,143,93,43,156,-)
%?px<%xd(Progressa)|%xd(Progressb)|%xd(Progressc)|%xd(Progressd)|%xd(Progresse)|%xd(Progressf)|%xd(Progressg)|%xd(Progressh)|%xd(Progressi)|%xd(Progressj)|%xd(Progressk)|%xd(Progressl)|%xd(Progressm)|%xd(Progressn)|%xd(Progresso)|%xd(Progressp)|%xd(Progressq)|%xd(Progressr)|%xd(Progresss)|%xd(Progresst)|%xd(Progressu)>

#%pb(-,-,-,-,Playhead.bmp,vertical,invert,backdrop,ProgressBg)
#
#-- Song Info --#
#
#-- Playlist Counter --#
%Vl(Player,26,43,58,19,4)
%ar%pp 
%Vl(Player,84,41,58,19,3)
%al/ %pe
#
#-- Song Title --#
%Vl(titlesingle,188,76,157,30,6)
%s%ar%?it<%it|%fn>
#
#-- Toggle the Secondary info according to user preference (adopted from AdwaitaPod) --#
%Vl(Player,198,107,147,23,5)
%s%ar%?it<%?if(%St(statusbar), =,off)<%t(6)%ia;%t(6)%id;%t(0)>%?if(%St(statusbar), =,top)<%id>%?if(%St(statusbar), =,bottom)<%ia>|%d(1)>
#
#-- Release Year & Genre (When available) --#
%Vl(Player,202,137,143,23,3)%Vf(bdbabd)
%s%ar%?it<%?iy<%ss(0,4,%iy)%?ig< - %ig>|%?ig<%ig|%fc>>|%fc>
#
#-- Player Slider --#
#%Vl(Player,90,72,36,115,-)
#%pb(-,-,-,-,image,PlayerSlider.bmp,vertical,invert)
#
#-- Play time --#
%Vl(Player,204,177,50,23,3)
%al%pc
%Vl(Player,295,177,50,23,3)
%ar%pt
#
#-- Shuffle & Repeat Status --#
%Vl(Player,253,182,16,15,-)
%xd(ShuffleIcon,%ps)
%Vl(Player,280,181,17,17,-)
%xd(RepeatIcon,%mm)
#
#-- Play status icon --#
%Vl(Player,255,212,31,32,-)
%xd(PlayIcon,%mp)
#
%Vl(Player,207,222,15,13,-)
%?if(%pp, =, 1)<%xd(PlaylistPositionIcon,1)|%xd(PlaylistPositionIcon,2)>
%Vl(Player,319,222,14,13,-)
%?if(%pp, =, %pe)<%xd(PlaylistPositionIcon,3)|%xd(PlaylistPositionIcon,4)>
#
#--- Volume Overlay ---#
%Vl(Player,175,258,17,15,-)
%?if(%pv, =, -90)<%xd(VolumeIcons,1)>
%?and(%if(%pv, <=, -60),%if(%pv,>,-90))<%xd(VolumeIcons,2)>
%?and(%if(%pv, <=, -30),%if(%pv,>,-60))<%xd(VolumeIcons,3)>
%?if(%pv,>,-30)<%xd(VolumeIcons,4)>
%Vl(Player,204,263,145,4,-)
%Vf(4a92e6)
%pv(-,-,-,-,noborder)
#
