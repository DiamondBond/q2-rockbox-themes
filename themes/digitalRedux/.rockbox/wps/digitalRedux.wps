#######################################
## THEME NAME: digitalRedux (Version 2.0)
## BY D Juarez  December 2026
## Hi everyone! This is the updated version of my take on
## the digital Theme. At this point I'm comfortable with calling
## it my own work as pretty much all of the code is mine.
## Changelog:
## * Removed icon sets and loading icons and replaced them with
##   unicode characters
## * Different fonts for CJK support
## * Split screens if music is playing
## * New colorscheme
## * Modified battery icon and icon display logic
##
## Comments or questions, let me know on the Rockbox forums or
## on the Rockbox subreddit
## Happy listening! :)))))
#
# Version 1.1 Update:
# Changelog:
#    * Revised battery icon
#    * Revised battery icon logic
#    * Altered themes (shouldn't be noticeable)
#    * Alignment fixed
#    * Split or whole screen logic change
#
# Version 1.2 Update:
# Changelog:
#    * Replaced progress bar and backdrop
#    * Added battery percentage toggle option
#      via battery display numeric option
#    * Added split screen toggle option
#      via volume display graphic option
#    * Fixed split screen bug when track with
#      no album art is present or album art
#      is switched off
#### WPS FILE ########################

############ Status Bar ##############
## Disable Status Bar
%wd

## Preload Fonts
%Fl(2,20-NotoSansSymbols2-Regular_REDUCED.fnt)
%Fl(3,17-MPLUSRounded1c-Medium_NUMBERS.fnt)
%Fl(5,18-MPLUSRounded1c-Medium_EXTENDED_V1.fnt)
%Fl(6,20-MPLUSRounded1c-Bold_.fnt)
%Fl(7,13-MPLUSRounded1c-Bold_REDUCED.fnt)

Status Bar Background
%V(22,30,331,17,-)%Vb(-)

%xl(p,foreground.bmp,0,0,1)
%xl(q,background.bmp,0,0,1)

## Volume
# %V(5,6,20,17,9)%Vf(-)%Vb(-)
# Ⓥ

## Volume Bar
%V(26,31,31,27,3)%Vf(-)%Vb(-)
%ar%pv
%V(60,35,16,16,7)%Vf(-)&Vb(-)
%aldb

# %xl(p,volume_fg.bmp,0,0,1)
# %xl(q,volume_bg.bmp,0,0,1)
%V(80,40,65,7,-)%Vf(e2d9d1)%Vb(-)
%pv(0,0,65,7,p,backdrop,q)

## Toggle Battery Percent Level
%?if(%St(battery display),=,numeric)<%VI(batteryLevel)%Vd(batteryLevel)|%VI(noBatteryLevel)%Vd(noBatteryLevel)>

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Battery Percent level Disabled
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

## Repeat
%Vl(noBatteryLevel,265,32,16,21,6)%Vf(-)%Vb(-)
%?mm<|∞|∞|∞|∞>

## Shuffle
%Vl(noBatteryLevel,294,34,16,21,6)%Vf(-)%Vb(-)
%?ps<⇄|>

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Battery Percent level Enabled
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

## Repeat
%Vl(batteryLevel,238,33,16,21,6)%Vf(-)%Vb(-)
%?mm<|∞|∞|∞|∞>

## Shuffle
%Vl(batteryLevel,271,35,16,21,6)%Vf(-)%Vb(-)
%?ps<⇄|>

## Battery Percent Level
%Vl(batteryLevel,293,30,29,21,3)%Vf(-)%Vb(-)
%ar%bl

## Battery Icon
%xl(H,battery_level.bmp,0,0,14)
%V(328,35,20,12,5)%Vb(-)%Vf(-)
%?bp<
    %?bc<
	    %?bl<|
	        %t(0.6)%xd(H,3);%t(0.6)%xd(H,4);%t(0.6)%xd(H,5);%t(0.6)%xd(H,6);%t(0.6)%xd(H,7);%t(0.6)%xd(H,8);%t(0.6)%xd(H,9);%t(0.6)%xd(H,10);%t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,4);%t(0.6)%xd(H,5);%t(0.6)%xd(H,6);%t(0.6)%xd(H,7);%t(0.6)%xd(H,8);%t(0.6)%xd(H,9);%t(0.6)%xd(H,10);%t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,5);%t(0.6)%xd(H,6);%t(0.6)%xd(H,7);%t(0.6)%xd(H,8);%t(0.6)%xd(H,9);%t(0.6)%xd(H,10);%t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,6);%t(0.6)%xd(H,7);%t(0.6)%xd(H,8);%t(0.6)%xd(H,9);%t(0.6)%xd(H,10);%t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,7);%t(0.6)%xd(H,8);%t(0.6)%xd(H,9);%t(0.6)%xd(H,10);%t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,8);%t(0.6)%xd(H,9);%t(0.6)%xd(H,10);%t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,9);%t(0.6)%xd(H,10);%t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,10);%t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,11);%t(0.6)%xd(H,12);%t(0.6)%xd(H,13)|
	        %t(0.6)%xd(H,12);%t(0.6)%xd(H,13)>|
		%xd(H,14)>|
	%?bl<|
	    %t(0.6)%xd(H,2);%t(0.6)%xd(H,1)|
		%xd(H,3)|
		%xd(H,4)|
		%xd(H,5)|
		%xd(H,6)|
		%xd(H,7)|
		%xd(H,8)|
		%xd(H,9)|
		%xd(H,10)|
		%xd(H,11)|
		%xd(H,12)|
		%xd(H,13)|
		%xd(H,13)>>

############### Main View #################

# Album Art/Info Viewport Conditional
%?C<%Vd(a)|%Vd(b)>

## Main Panel
%Vi(-,22,47,331,212,5)%Vf(-)%Vb(-)
%?mp<|%Vd(e)|%Vd(f)|||%Vd(g)|%Vd(h)|%Vd(i)|%Vd(j)>%Vf(-)

### If Album Art Present --------------------

## Album Cover
%Vl(a,27,59,166,174,-)
%Cl(0,0,166,166,c,c)
%Cd

# e 2 d 9 d 1 

## Track Name
%Vl(a,199,70,149,27,6)%Vf(e2d9d1)%Vb(-)
%s%it

## Artists Name
%Vl(a,199,94,149,27,5)%Vf(e2d9d1)%Vb(-)
%?if(%ss(0,15,%ia), =,%ia)<%ia|%ss(0,15,%ia)...>

## Album Name
%Vl(a,199,124,149,27,5)%Vf(e2d9d1)%Vb(-)
%?if(%ss(0,15,%id), =,%id)<%id|%ss(0,15,%id)...>

## Playback Mode
%Vl(a,199,173,15,18,2)%Vf(-)%Vb(-)
%al%?mp<⏹|⏵|⏸|⏩|⏪|>

## Timer
%Vl(a,212,174,136,33,3)%Vf(e2d9d1)%Vb(-)
%al%pc/%pt

## Peak Meter
## %Vl(a,171,160,144,27,2)%Vf(-)%Vb(-)
## %pm

### If Album Art Not Present --------------------

## Track Name
%Vl(b,27,84,321,27,6)%Vf(e2d9d1)%Vb(-)
%s%ac%it

## Artists Name
%Vl(b,27,109,321,27,5)%Vf(e2d9d1)%Vb(-)
%s%ac%ia

## Album Name
%Vl(b,27,142,321,27,5)%Vf(e2d9d1)%Vb(-)
%s%ac%id

## Playback Mode
%Vl(b,27,173,16,18,2)%Vf(-)%Vb(-)
%al%?mp<⏹|⏵|⏸|⏩|⏪|>

## Timer
%Vl(b,41,174,307,33,3)%Vf(e2d9d1)%Vb(-)
%al%pc/%pt

