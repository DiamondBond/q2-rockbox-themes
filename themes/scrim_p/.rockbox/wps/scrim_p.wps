#-----------------------------------------------#
#scrim_p
#by Anthony Fletcher for PodBox
#CC BY-SA 3.0 (unofficial Shanling Q2 port: 375x320)
#-----------------------------------------------#
#
#--- Fonts ---#
#
%Fl(2,22-noto-sans-medium.fnt)
%Fl(3,12-noto-sans.fnt)
%Fl(4,24x24-icons.fnt)
#
#--- Background layer ---#
#
# Album art, alone: it is drawn at the end of its viewport, over anything else
# in it
%V(0,0,-,-,-)%VB%Cl(73,12,228,228,c,c)%Cd
#
# Progress track, its viewport no larger than it: a %VB viewport clears its
# whole rect, art included
%V(92,297,191,3,-)%VB
%dr(0,0,191,3,3a3f49)
#
#--- Foreground layer ---#
#
%V(0,0,-,-,-)
#
# Disable the status bar
%wd
#
# Volume overlay while the volume changes
%?mv(3)<%Vd(Volume)|>
#
# Pause bars over the cover while paused
%?mp<||%Vd(Paused)||>
#
# Under the cover
#
# - Track title
%V(20,243,335,26,2)%Vf(ffffff)
%s%ac%it
#
# - Sub-line: artist, album, artist-album, album-artist or
#   playlist_name, per scrim.preferences
%V(24,270,327,20,-)%Vf(ffffff)
%s%ac%?if(%ft(themes/scrim.preferences,sub-line mode:),=,artist)<%ia|%?if(%ft(themes/scrim.preferences,sub-line mode:),=,playlist_name)<%pn|%?if(%ft(themes/scrim.preferences,sub-line mode:),=,artist-album)<%?ia<%ia%?id< - |>|>%id|%?if(%ft(themes/scrim.preferences,sub-line mode:),=,album-artist)<%?id<%id%?ia< - |>|>%ia|%id>>>>
#
# Progress
%V(92,297,191,3,-)%Vf(d92626)%pb(0,0,-,-,noborder)
#
# - Elapsed time
%V(46,292,42,14,3)%Vf(ffffff)
%al%pc
# - Remaining time
%V(287,292,42,14,3)%Vf(ffffff)
%ar%pr
#
# Status icons in the cover's right gutter - shuffle H, repeat J
%V(322,30,24,48,4)%Vf(ffffff)
%?ps<H>
%?mm<|J|J|J|J>
#
# Pause bars, centred on the cover, outlined so they read on a white cover
%Vl(Paused,159,94,56,64,-)
%dr(0,0,20,64,000000)%dr(36,0,20,64,000000)%dr(2,2,16,60,ffffff)%dr(38,2,16,60,ffffff)
#
# Volume overlay, on a band of its own: a hidden viewport shows the art under it
%Vl(Volume,0,0,-,44,-)
%dr(0,0,375,44,000000)
%Vl(Volume,50,10,275,24,4)%Vg(000000,000000,ffffff)%Vf(ffffff)
%Vs(gradient)%?pv<M|N|N>%arO
%Vl(Volume,82,19,211,6,-)%Vf(ffffff)
%dr(0,0,211,6,3a3f49)%pv(0,0,211,6,noborder)
