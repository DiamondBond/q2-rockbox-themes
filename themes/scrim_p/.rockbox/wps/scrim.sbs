#-----------------------------------------------#
#scrim
#by Anthony Fletcher for PodBox
#CC BY-SA 3.0 (unofficial Shanling Q2 port: 375x320)
#-----------------------------------------------#
#
#--- Fonts ---#
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,18-noto-sans.fnt)
#
#--- Images ---#
#
# The volume bar's track and fill. A bar drawn without a fill image clears its
# empty part to what is behind it, even with a backdrop image
%xl(vbg,volband.bmp,0,0)
%xl(vwf,volfill.bmp,0,0)
#
#--- Background layer ---#
#
%V(0,0,-,-,-)%VB
%dr(0,0,375,44,d92626)
#
#--- Foreground layer ---#
#
%V(0,0,-,-,-)
#
# Top bar
%?mv(3)<%Vd(Volume)|%Vd(Chrome)>
#
# Setup rows
%Lb(Rows,347,34)
#
# - Title
%Vl(Chrome,40,16,190,20,3)%Vf(ffffff)%Vb(d92626)
%s%Lt
#
# - Time
%Vl(Chrome,230,16,78,20,4)%Vf(ffffff)%Vb(d92626)
%ar%?cf<%cH:%cM|%cl:%cM %cP>
#
# - Battery. The charging glyphs mirror the level glyphs band for band
%Vl(Chrome,312,14,24,24,2)%Vf(ffffff)%Vb(d92626)
%ar%?bc<%?bl<·|·|¸|¸|¸|¸|¹|º>|%?bl<1|1|2|3|4|5|6|7>>
#
# List viewport
%Vi(-,14,50,347,238,-)
#
# - Row icon: the firmware's themable_icons (apps/gui/icon.h) drawn from the
#   icon font, in place of PodBox's by-name row icons
%Vl(Rows,4,5,24,24,2)
%?Lc<%Vf(ffffff)|%Vf(a9aeb8)>%?if(%LI,=,0)<a>%?if(%LI,=,1)<¢>%?if(%LI,=,2)<ð>%?if(%LI,=,3)<Þ>%?if(%LI,=,4)<Ê>%?if(%LI,=,5)<ñ>%?if(%LI,=,6)<l>%?if(%LI,=,7)<»>%?if(%LI,=,8)<Ç>%?if(%LI,=,9)<Ó>%?if(%LI,=,10)<T>%?if(%LI,=,11)<W>%?if(%LI,=,12)<U>%?if(%LI,=,13)<U>%?if(%LI,=,14)<l>%?if(%LI,=,15)<Þ>%?if(%LI,=,16)<¿>%?if(%LI,=,17)<Í>%?if(%LI,=,18)<Þ>%?if(%LI,=,19)<Þ>%?if(%LI,=,20)<ß>%?if(%LI,=,23)<Ç>%?if(%LI,=,24)<Ò>%?if(%LI,=,25)<W>%?if(%LI,=,26)<Ê>%?if(%LI,=,27)<Ê>%?if(%LI,=,29)<¢>%?if(%LI,=,30)<P>%?if(%LI,=,31)<»>
#
# - Selection bar: a gradient fill of the line, since a conditional that flips
#   clears its line's rect over anything %dr drew there
%Vl(Rows,36,5,3,24,2)%Vg(d92626,d92626,ffffff)
%?Lc<%Vs(gradient)> 
#
# - Row text
%Vl(Rows,46,7,295,20,4)
%?Lc<%Vf(ffffff)|%Vf(a9aeb8)>%s%LT
#
# Volume overlay, over the top bar
%Vl(Volume,50,14,275,24,2)%Vf(ffffff)%Vb(d92626)
%?pv<M|N|N>%arO
%Vl(Volume,82,23,211,6,-)%Vf(ffffff)
%pv(0,0,211,6,image,vwf,backdrop,vbg)
