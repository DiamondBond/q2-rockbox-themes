#	Load needed fonts
%Fl(3,15-Inter-Bold.fnt)
%Fl(8,20-Inter-SemiBold.fnt)
#
#	Preload icons
%xl(L,busy_indicator.bmp,0,7,16)
%xl(B,batt_status.bmp,0,0,10)
%xl(speaker_too_loud,speaker_too_loud.bmp,0,0)
