%pb(0,0,374,8,pb.bmp)

# Progress Times
%V(34,19,46,9,0) %Vf(CCCCCC) %Vb(000000)
%al%pc
%V(296,19,46,9,0) %Vf(CCCCCC) %Vb(000000)
