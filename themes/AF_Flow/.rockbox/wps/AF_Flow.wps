# Artist
%V(50,235,274,17,4)
%ac%?ia<%ia|%?d(2)<%d(2)|>>
# Title
%V(50,255,274,17,4)
%s%ac%t(10)%?it< %it | %fn > ;%s%ac%t(5)%?It< Next: %It |>

# Volume Up Button
%V(52,263,41,49,-)
#%xd(a)
%T(0,0,41,47,volup)
%T(0,0,41,47,volup,repeat_press)
%?mv(0.1)<%xd(t)|%xd(a)>

# FWD + RWD Button
%V(214,269,41,49,0)%Vf(CCCCCC)%Vb(000000)
%T(0,0,41,47,next)
%T(0,0,41,47,ffwd,repeat_press)
%?mp<%xd(d)|%xd(d)|%xd(d)|%xd(K)|%xd(d)>

%V(121,269,41,49,0)%Vf(CCCCCC)%Vb(000000)
