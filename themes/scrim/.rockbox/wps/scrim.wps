#-----------------------------------------------#
#scrim
#by Anthony Fletcher for PodBox
#CC BY-SA 3.0 (unofficial Shanling Q2 port: 375x320)
#-----------------------------------------------#
#
#--- Fonts ---#
#
%Fl(2,26-noto-sans-medium.fnt)
%Fl(3,12-noto-sans.fnt)
%Fl(4,24x24-icons.fnt)
#
#--- Background layer ---#
#
# Album art, alone: it is drawn at the end of its viewport, over anything else
# in it
%V(0,0,-,-,-)%VB%Vf(000000)%Cl(55,0,320,320,c,c)%Cd
#
# Accent strip, album panel and progress track, each viewport no larger than
# what it draws: a %VB viewport clears its whole rect, art included
%V(0,0,55,320,-)%VB
%dr(0,0,55,320,d92626)
%V(0,124,290,81,-)%VB
%dr(0,0,290,76,d92626)
%dr(0,76,290,5,7a1515)
#
#--- Foreground layer ---#
#
%V(0,0,-,-,-)
#
# Disable the status bar
%wd
#
# Volume overlay while the volume changes
%?mv(3)<%Vd(Volume)|>
#
# - Track title
%V(12,130,270,28,2)%Vf(ffffff)%Vb(d92626)
%s%it
#
# - Sub-line: artist, album, artist-album, album-artist or
#   playlist_name, per scrim.preferences
%V(12,166,270,20,-)%Vf(ffffff)%Vb(d92626)
%s%?if(%ft(themes/scrim.preferences,sub-line mode:),=,artist)<%ia|%?if(%ft(themes/scrim.preferences,sub-line mode:),=,playlist_name)<%pn|%?if(%ft(themes/scrim.preferences,sub-line mode:),=,artist-album)<%?ia<%ia%?id< - |>|>%id|%?if(%ft(themes/scrim.preferences,sub-line mode:),=,album-artist)<%?id<%id%?ia< - |>|>%ia|%id>>>>
#
# Progress
%V(0,200,290,5,-)%Vf(ffffff)%pb(0,0,-,-,noborder)
#
# Under panel, in the strip
#
# - Track number
%V(10,214,40,14,3)%Vf(ffffff)%Vb(d92626)
%?if(%pp,<,10)<0>%pp
#
# - Remaining time
%V(10,232,40,14,3)%Vf(ffffff)%Vb(d92626)
%pr
#
# Status icons, stacked to fit the strip - Transport: stopped C, playing A,
# paused B, ffwd G, rewind F. play-pause icon: next in scrim.preferences
# swaps A and B. Shuffle H, repeat J.
%V(16,16,24,72,4)%Vf(ffffff)%Vb(d92626)
%?if(%ft(themes/scrim.preferences,play-pause icon:),=,next)<%?mp<C|B|A|G|F>|%?mp<C|A|B|G|F>>
%?ps<H>
%?mm<|J|J|J|J>
#
# Volume overlay, on a band of its own: a hidden viewport shows the art under it
%Vl(Volume,0,0,-,40,-)
%dr(0,0,375,40,000000)
%Vl(Volume,16,8,343,24,4)%Vg(000000,000000,ffffff)%Vf(ffffff)
%Vs(gradient)%?pv<M|N|N>%arO
%Vl(Volume,48,17,279,6,-)%Vf(ffffff)
%dr(0,0,279,6,3a3f49)%pv(0,0,279,6,noborder)
