		%xd(H,13)>>

## Main Panel

## Logic to for when to split the screen into single or dual viewports
# Play, Pause, and album artwork ------> split
# else -----> whole screen

# %?or(%if(%cs,=,1),%if(%cs,=,7),%if(%cs,=,8))<%?mp<%?C<%VI(split)%Vd(split)|%VI(whole)%Vd(whole)>|%?C<%VI(split)%Vd(split)|%VI(whole)%Vd(whole)>|%?C<%VI(split)%Vd(split)|%VI(whole)%Vd(whole)>>|%VI(whole)%Vd(whole)>
%?if(%St(volume display),=,graphic)<%?or(%if(%cs,=,1),%if(%cs,=,7),%if(%cs,=,8))<%?mp<%?C<%VI(split)%Vd(split)|%VI(whole)%Vd(whole)>|%?C<%VI(split)%Vd(split)|%VI(whole)%Vd(whole)>|%?C<%VI(split)%Vd(split)|%VI(whole)%Vd(whole)>>|%VI(whole)%Vd(whole)>|%VI(whole)%Vd(whole)>

%Vi(split,43,79,186,189,6)%Vf(e2d9d1)%Vb(-)
%Vi(whole,43,79,289,189,6)%Vf(e2d9d1)%Vb(-)

## Set up viewport for album artwork
%Vl(split,229,79,103,189,-)
%Cl(-28,0,331,248,l,l)
%Cd
