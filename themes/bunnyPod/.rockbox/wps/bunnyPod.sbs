# Theme: bunnyPod
# Version 1.0
# Last Update: 02/23/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: Cute bunny theme :3 featuring LanaPixel font by eishiya
# All pixel art is by me!!
# Code based on: 1ST_GEN_REMIX by me! which was based on SNARTY by Simon Anden and BONES by Chuck Largo!

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>


# Preload Fonts
%Fl(2,07-LanaPixel.fnt)
%Fl(3,14-LanaPixel.fnt)

#Preload Images
%xl(bunny_sbs,bunny_sbs.bmp,0,0)
%xl(bunny_usb,bunny_usb.bmp,0,0)
%xl(music_note,music_note.bmp,0,0)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(disk,disk.bmp,0,0)
%xl(lock,lock.bmp,0,0,2)
%xl(corner,corner.bmp,0,0,4)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)%Vd(border)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)%Vd(border)>>

# Clear Screen
%Vi(clearScreen,22,30,1,1,-)

## Main Menu ##

# Main Menu UI Viewport
%Vi(mainMenu,32,84,218,184,3)

# Bunny SBS
%Vl(mainMenu,254,144,99,146,-)
%xd(bunny_sbs)

# Rounded corners
%Vl(border,22,30,6,6,-)
%xd(corner,1)
%Vl(border,347,30,6,6,-)
%xd(corner,2)
%Vl(border,22,284,6,6,-)
%xd(corner,3)
%Vl(border,347,284,6,6,-)
%xd(corner,4)

# Line
%Vl(mainMenu,27,69,321,2,-)
%dr(0,0,321,2)

# Play/Pause Icons
%Vl(mainMenu,32,38,23,23,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)>

# Shuffle Icon
%Vl(mainMenu,59,38,26,23,-)
%?if(%mp, >, 1)<%?ps<%xd(shuffle,1)|%xd(shuffle,2)>|>

# Repeat Icon
%Vl(mainMenu,93,38,26,23,-)
%?if(%mp, >, 1)<%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|>

# Hold / Device
%Vl(mainMenu,141,34,103,33,3)
%?mh<%acHOLD|>

# Battery Icon
%Vl(mainMenu,291,36,56,25,2)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Time
%Vl(mainMenu,260,84,88,27,3)
%ac%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Date
%Vl(mainMenu,260,117,88,16,2)
%ac%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>, %cb %cd

# Disk
%Vl(mainMenu,243,40,20,19,-)
%?lh<%t(0.5)%xd(disk,1);%t(0.5)|>

# Hold
%Vl(mainMenu,267,38,21,21,-)
%?mh<%xd(lock,2)|%xd(lock,1)>

# Mini Album Art
%Vl(mainMenu,32,268,17,18,-)
%Cl(1,1,14,14,c,c)
%?if(%mp, >, 1)<%?C<%Cd|%xd(music_note)>|>
%?if(%mp, >, 1)<%?C<%dr(0,0,17,1)>|>
%?if(%mp, >, 1)<%?C<%dr(0,16,17,1)>|>
%?if(%mp, >, 1)<%?C<%dr(0,1,1,14)>|>
%?if(%mp, >, 1)<%?C<%dr(16,1,1,14)>|>

# Now Playing
%Vl(mainMenu,53,268,201,17,2)
%?if(%mp, >, 1)<%al%s%?it<%it|%fn>%?ia< - %ia>|>

## Quick Screen ##

# Clear Screen
%?if(%cs, =, 10)<%Vd(QuickScreen)%VI(QuickScreen)>

# Quick Screen Viewport
%Vi(QuickScreen,32,73,207,193,2)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,375,320,-)

%Vl(usbScreen,136,138,108,139,-)
%xd(bunny_usb)

# Time / Battery (numerical)
%Vl(usbScreen,32,35,249,27,3)
%al%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Battery Icon
%Vl(usbScreen,291,38,56,24,2)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(usbScreen,27,69,321,2,-)
%dr(0,0,321,2)

# USB Text
%Vl(usbScreen,84,84,207,29,3)
%acUSB CONNECTED%Vs(invert)

# Eject Warning
%Vl(usbScreen,84,117,207,19,2)
%ac%t(1)! EJECT BEFORE DISCONNECTING !;%t(.1)%ac

# Battery (numerical
%Vl(usbScreen,244,192,52,20,2)
%al%bl%%