# Theme: bunnyPod
# Version 1.0
# Last Update: 02/23/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: Cute bunny theme :3 featuring LanaPixel font by eishiya
# All pixel art is by me!!
# Code based on: 1ST_GEN_REMIX by me! which was based on SNARTY by Simon Anden and BONES by Chuck Largo!
# Note: if you want the hold screen to not show album art just switch the #'s for Show Album Art/Hide Album Art

## WPS File ##

#Hide The Status Bar
%wd

# Preload Backdrop #
%xl(bunnyPod,bunnyPod.bmp,22,30)

# Clear Backdrop
%V(0,0,375,320,-)%VB
%xd(bunnyPod)
%V(0,0,375,320,-)

# Preload Fonts
%Fl(2,07-LanaPixel.fnt)
%Fl(3,14-LanaPixel.fnt)

# Preload Images
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(PB,pb.bmp,0,0)
%xl(PBB,pb_back.bmp,0,0)
%xl(VB,vb.bmp,0,0)
%xl(VBB,vb_back.bmp,0,0)
%xl(disk,disk.bmp,0,0)
%xl(lock,lock.bmp,0,0,2)
%xl(closed_eyes,closed_eyes.bmp,0,0,2)

# Show Album Art on Hold Screen (default)
%Vd(mainDisplay)%?C<%Vd(mainDisplayArt)|%Vd(mainDisplayNoArt)>>

# Hide Album Art on Hock Screen
#%?mh<%Vd(mainDisplay)%Vd(holdScreen)|%Vd(mainDisplay)%?C<%Vd(mainDisplayArt)|%Vd(mainDisplayNoArt)>>

# Clear Screen
%Vl(mainDisplay,0,0,375,320,-)

## Album Art ##
%Vl(mainDisplayArt,155,73,78,82,-)
%Cl(2,2,73,73)
%dr(0,0,78,1)
%dr(0,77,78,1)
%dr(0,1,1,77)
%dr(77,1,1,77)
%?C<%Cd>

## Main Display ##

# Disk Icons
%Vl(mainDisplay,289,70,20,20,-)
%?lh<%t(0.5)%xd(disk);%t(0.5)|>

# Hold (text)
%Vl(mainDisplay,163,42,26,13,2)
%?mh<HOLD|>

# Hold Icon
%Vl(mainDisplay,141,38,21,21,-)
%?mh<%xd(lock,2)|%xd(lock,1)>

# Closed Eyes on Hold
%Vl(mainDisplay,41,217,35,13,-)
%?mh<%xd(closed_eyes,2)|%xd(closed_eyes,1)>

# Battery Icon
%Vl(mainDisplay,291,36,56,25,2)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Playlist Number
%Vl(mainDisplay,167,272,124,16,2)
%ac%pp / %pe

# Play/Pause Icons
%Vl(mainDisplay,65,50,23,23,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Repeat Icon
%Vl(mainDisplay,29,94,26,24,-)
%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>

# Shuffle Icon
%Vl(mainDisplay,29,120,26,24,-)
%?ps<%xd(shuffle,1)|%xd(shuffle,2)>

# Time
%Vl(mainDisplay,188,34,93,27,3)
%ar%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Line
%Vl(mainDisplay,105,227,186,1,-)
%dr(0,0,186,1)

# File Info
%Vl(mainDisplay,125,228,140,16,2)
%ac%s%fc | %fb kbps | %fk kHz

# Volume Bar
%Vl(mainDisplay,334,93,9,130,-)
%pv(0,0,8,124,VBB,backdrop,VB)

# Track Progress Bar
%Vl(mainDisplay,115,255,228,15,-)%Vf(-)%Vb(-)
%pb(0,0,-,14,PBB,backdrop,PB)

# Time Elapsed
%Vl(mainDisplay,115,272,52,16,2)
%al%pc

# Time Remaining
%Vl(mainDisplay,291,272,52,16,2)
%ar-%pr

## Track info with album art ##

# Album
%Vl(mainDisplayArt,76,158,240,16,2)
%ac%s%?id<%id>

# Track Title
%Vl(mainDisplayArt,74,174,243,33,3)
%ac%s%?it<%s%it|%fn>

# Artist
%Vl(mainDisplayArt,95,207,202,16,2)
%ac%s%?ia<%ia>

## Track info with no album art ##

# Album
%Vl(mainDisplayNoArt,74,122,238,16,2)
%ac%s%?id<%id>

# Track Title
%Vl(mainDisplayNoArt,74,138,238,33,3)
%ac%s%?it<%s%it|%fn>

# Artist
%Vl(mainDisplayNoArt,74,171,238,16,2)
%ac%s%?ia<%ia>

## Hold Screen (hides album art on hold)##

# Album
%Vl(holdScreen,74,122,238,16,2)
%ac%s%?id<%id>

# Track Title
%Vl(holdScreen,74,138,238,33,3)
%ac%s%?it<%s%it|%fn>

# Artist
%Vl(holdScreen,74,171,238,16,2)
%ac%s%?ia<%ia>
