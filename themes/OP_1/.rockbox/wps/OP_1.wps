#__Hold
%V(30,152,43,16,-)%Vf(556471)
%ac%?mh<HOLD|---->
#
#__Track Progress Bar
%V(30,173,315,40,-)
%pb(0,0,315,38,PBB,slider,PB)
#
#__Line
%V(30,216,315,5,-)%Vf(49392F)
%dr(0,0,315,5)
#
#__Volume Bar
%V(339,65,5,107,-)%Vf(F6230A)
%pv(0,0,4,101,vertical)
