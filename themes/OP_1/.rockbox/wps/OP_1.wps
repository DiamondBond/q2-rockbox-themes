#__Play/Pause Icons
%V(164,77,47,26,-)
%?mp<%xd(T)|%xd(L)|%xd(Z)|%xd(F)|%xd(R)>
#
#__Battery Bar
%V(168,117,34,18,-)%Vf(556471)
%bl(0,0,34,17)
%V(202,122,2,8,-)%Vf(556471)
%dr(0,0,2,8)
