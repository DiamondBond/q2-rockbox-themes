#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(wpsbackdrop-320x240x16.bmp)
#
# Preload Images
%xl(A,lock-320x240x16.bmp,0,0,2)
%xl(B,battery-320x240x16.bmp,0,0,10)
%xl(C,volume-320x240x16.bmp,0,0,36)
%xl(D,shuffle-320x240x16.bmp,0,0)
%xl(E,repeat-320x240x16.bmp,0,0,4)
%xl(F,playmode-320x240x16.bmp,0,0,5)
%xl(H,hdd-led-wps.bmp,0,0,2)
#
# Preload a specific font for some windows:
%Fl(2,15-Adobe-Helvetica.fnt)
#
# Album Art/Info Viewport Conditional
%?C<%Vd(a)%Vd(b)%Vd(c)|%Vd(A)%Vd(B)%Vd(C)>
#
# Progress Bar
%V(12,225,352,20,-)
%pb(0,0,352,20,pb-320x240x16.bmp)
#
# Hold
%V(102,276,35,31,-)
%?mh<%xd(Aa)|%xd(Ab)>
#
# Battery
%V(148,276,52,31,-)
%?bp<%?bc<%xd(Ba)|%xd(Bb)>|%?bl<|%xd(Bc)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)>>
#
# Disk activity
%V(346,36,13,15,-)
%?lh<%xd(Ha)|%xd(Hb)>
#
# Volume
%V(207,276,40,31,-)
%?pv<%xd(Ca)|%xd(Cb)|%xd(Cc)|%xd(Cd)|%xd(Ce)|%xd(Cf)|%xd(Cg)|%xd(Ch)|%xd(Ci)|%xd(Cj)|%xd(Ck)|%xd(Cl)|%xd(Cm)|%xd(Cn)|%xd(Co)|%xd(Cp)|%xd(Cq)|%xd(Cr)|%xd(Cs)|%xd(Ct)|%xd(Cu)|%xd(Cv)|%xd(Cw)|%xd(Cx)|%xd(Cy)|%xd(Cz)|%xd(CA)|%xd(CB)|%xd(CC)|%xd(CD)|%xd(CE)|%xd(CF)|%xd(CG)|%xd(CH)|%xd(CI)|%xd(CJ)>
#
# Shuffle
%V(255,281,43,21,-)
%?ps<%xd(D)>
#
# Repeat
%V(306,276,21,31,-)
%?mm<|%xd(Ea)|%xd(Eb)|%xd(Ec)|%xd(Ed)>
#
# Playmode
%V(307,276,28,31,-)
%?mp<%xd(Fa)|%xd(Fb)|%xd(Fc)|%xd(Fd)|%xd(Fe)>
#
# Track x of y
%V(12,249,148,27,2)%Vf(EEEEEE)%Vb(000000)
%al%?Sr<%pe %Sx(of) %pp|%pp %Sx(of) %pe>
#
# Current time / track length plus flashing warning when track is ending
%V(246,249,117,27,2)%Vf(EEEEEE)%Vb(000000)
%ar%?pE(6)<%t(1)*;%t(1)|>%pc / %pt
#
# Album Art
%ax%Vl(a,19,40,152,173,-)
%Cl(0,0,152,173,c,c)
%Cd
#
# Peak Meter
%V(148,252,100,19,-)%Vf(666666)%Vb(000000)
%pm
#
# Track Info - Album Art
%ax%Vl(a,179,40,178,75,-)%Vf(FFFFFF)%Vb(000000)
%s%al%?it<%it|%fn>
%s%al%?ia<%ia|%?d(2)<%d(2)|%(root%)>>
%s%al%?id<%id|%?d(1)<%d(1)|%(root%)>>%?iy< [%iy]>
#
# File info.
%ax%Vl(b,179,115,178,27,-)%Vf(999999)%Vb(000000)
%t(6)%alCodec: %fc;%t(6)%al%fbkbps %fv;%t(4)%al%Sx(Pitch): %Sp%%;%t(4)%al%Sx(Volume): %pvdB;%t(4)%alTags: %?iv<ID3v%iv|none>
#%?if(%Sp,=,100.0)<%alPITCH NORMAL|%alPITCH ADJUSTED>
#
%ax%Vl(c,179,152,178,67,-)%Vf(EEEEEE)%Vb(000000)
%s%al%Sx(Next Track:)
%?if(%pp,!=,%pe)<%s%al%?It<%It|%Fn>|%al[%Sx(End of Song List)]>
%?if(%pp,!=,%pe)<%s%al%?Ia<%Ia>|>
#
# Track Info - No Album Art
%ax%Vl(A,12,40,352,115,-)%Vf(FFFFFF)%Vb(000000)
%s%ac%?it<%it|%fn>
%s%ac%?ia<%ia|%?d(2)<%d(2)|%(root%)>>
%s%ac%?id<%id|%?d(1)<%d(1)|%(root%)>>%?iy< [%iy]>
#
# File info.
%ax%Vl(B,12,115,352,27,-)%Vf(999999)%Vb(000000)
%t(6)%acCodec: %fc;%t(6)%ac%fbkbps %fv;%t(4)%ac%Sx(Pitch): %Sp%%;%t(4)%ac%Sx(Volume): %pvdB;%t(4)%acTags: %?iv<ID3v%iv|none>
#
%ax%Vl(C,12,155,352,67,-)%Vf(EEEEEE)%Vb(000000)
%ac%Sx(Next Track:)
%?if(%pp,!=,%pe)<%s%ac%?It<%It|%Fn>|%ac[%Sx(End of Song List)]>
%?if(%pp,!=,%pe)<%s%ac%?Ia<%Ia>|>