#------------ Background Layer ------------#
%V(0,0,-,-,4)%VB
%?if(%cs, =, 1)<%?mh<%?if(%St(backlight on button hold), =, off)<%dr(0,0,-,-,ffffff)|%xd(Lockscreen)%?mp<%?bp<|%?if(%bl, <=, 15)<%xd(NotificationBackdrop)>>|%xd(NotificationBackdrop)>>|%?mp<%xd(ClockHours,%cl)|%Cl(227,41,136,136)%Cd%?C<|%xd(MiniPlayerMode,1)>>>>
