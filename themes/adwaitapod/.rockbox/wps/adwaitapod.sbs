# First part turns off rounded corners if our default font isnt used.
%Vl(HalfWidth,20,39,190,253,-)%?if(%ss(3, 20, %St(font)), =, Cantarell-Regular)<%?if(%St(scrollbar),!=,left)<%xd(LRounded)>%?if(%St(scrollbar),!=,right)<%xd(RHalfWidthRound)>>
%Vl(FullWidth,20,39,335,253,-)%?if(%ss(3, 20, %St(font)), =, Cantarell-Regular)<%?if(%St(scrollbar),!=,left)<%xd(LRounded)>%?if(%St(scrollbar),!=,right)<%xd(RFullWidthRound)>>
