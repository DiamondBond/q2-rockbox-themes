%?if(%cs, =, 21)<%xd(Lockscreen)%xd(NotificationBackdrop)>
# Really weird bugs happen if drawn seperately. I don't know why, but this shit works so.
%?if(%cs, =, 10)<%dr(0,0,-,-,f7f7f7)%xd(BackButton)%xd(BatteryBackdrop)%?bs<%xd(SleepBackdrop)>|%?and(%if(%cs, !=, 21),%if(%cs, !=, 10),%if(%cs, !=, 1))<%dr(0,0,-,28,e7e7e7)%dr(0,28,-,1,d6d7d6)>%?if(%cs, =, 1)<%?mh<|%dr(0,0,-,28,e7e7e7)%dr(0,28,-,1,d6d7d6)>>%?if(%cs, =, 3)<%xd(MiniPlayerMode,2)%dr(214,36,1,238,d6d7d6)%xd(RecDisplays)>>
#--- Quickscreen Button Logic ---#
%?if(%cs, =, 10)<%?and(%if(%St(qs left),=,shuffle),%if(%St(qs right),=,repeat),%if(%St(qs top),=,brightness),%if(%St(qs bottom),=,brightness))<%?ps<%dr(39,164,108,45,3982e7)|%dr(39,164,108,45,dedede)>%?mm<%dr(39,220,108,45,dedede)|%dr(39,220,108,45,3982e7)>%dr(216,164,108,45,3982e7)%dr(216,220,108,45,3982e7)>>
