# 13 offset to prevent OOB in Quickscreen.
# without it, causes a crash on some devices.
%Vi(Empty,165,0,103,81,9)%Vf(f7f7f7)
%Vi(USB,84,0,1,1,9)
%Vi(FullWidth,20,39,335,253,-)
%Vi(HalfWidth,20,39,190,253,-)
%Vl(HalfWidth,214,41,1,271,-)%dr(0,0,-,-,d6d7d6)
