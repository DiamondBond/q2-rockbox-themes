#__Hold
%Vl(hold,106,34,119,36,4)
%acLOCKED%Vs(invert)
#
#__Storage LED
%V(230,34,13,13,2)
%xd(X,%lh)
#
#__Eq
%V(247,34,13,13,2)
%?St(eq enabled)<%xd(Q)|>
#
#__Shuffle
%V(230,50,13,13,2)
%xd(S,%ps)
#
#__Repeat
%V(247,50,13,13,2)
%xd(R,%mm)
#
#__Volume BAR
%V(264,34,81,11,-)
%pv(0,0,-,-,BB,backdrop,BBB)
#
#__Battery/Vol Screen Selector
%?mv(3.5)<%Vd(volChange)|%?bp<%Vd(batCharge)|%Vd(bat)>>
#
#__Battery/Vol Text
%Vl(bat,264,46,81,19,3)
%ac%t(8)%xd(P) %bl%%%Vs(invert);%ac%?if(%bt, =, -1)<%t(0)|%t(8)%xd(P)  %bt%Vs(invert)>
#
%Vl(batCharge,264,46,81,19,3)
%ac%t(8)CHARGING%Vs(invert);%t(8)%ac%xd(P) %bl%%%Vs(invert)
#
%Vl(volChange,264,46,81,19,3)
%acVOL %pv
