%wd
%Fl(3,16-Cantarell-Regular.fnt,11)
%Fl(4,18-Cantarell-Regular.fnt)
%Fl(5,18-Cantarell-Bold.fnt)
%Fl(6,20-Cantarell-Regular.fnt)
%Fl(7,20-Cantarell-Bold.fnt)
%Fl(8,66-Cantarell-Light.fnt,16)
#-- Icons --#
%xl(PlayIcon,PlayStatus.bmp,9)
%xl(SleepIcon,SleepStatus.bmp,2,1)
%xl(SleepIconAOD,SleepStatusAOD.bmp,2,1)
%xl(HoldIcon,HoldStatus.bmp,2,1)
%xl(L,LoadingStatus.bmp,12)
%xl(I,LoadingStatusAOD.bmp,12)
%xl(BatteryIcon,BatteryStatus.bmp,12)
%xl(ChargingIcon,ChargeStatus.bmp,11)
%xl(BatteryIconAOD,BatteryStatusAOD.bmp,12)
%xl(ChargingIconAOD,ChargeStatusAOD.bmp,11)
%xl(ShuffleIcon,ShuffleStatus.bmp,2)
%xl(RepeatIcon,RepeatStatus.bmp,5)
%xl(LosslessIcon,LosslessIcon.bmp)
%xl(ExplicitIcon,ExplicitIcon.bmp)
#-- Playtime Slider --#
%xl(PlayerSlider,PlayerSlider.bmp)
%xl(SliderBackdrop3Digits,SliderBackdrop.bmp)
%xl(SliderBackdrop4Digits,SliderBackdrop4Digits.bmp)
%xl(SliderBackdrop5Digits,SliderBackdrop5Digits.bmp)
%xl(SliderBackdrop6Digits,SliderBackdrop6Digits.bmp)
#-- Album Art --#
%xl(TLoverlay,WpsTL.bmp)
%xl(TRoverlay,WpsTR.bmp,162,0)
%xl(BLoverlay,WpsBL.bmp,0,162)
%xl(BRoverlay,WpsBR.bmp,162,162)
%xl(BackdropL,WpsBackdropL.bmp,81,0)
%xl(BackdropR,WpsBackdropR.bmp,273,0)
%xl(BackdropT,WpsBackdropT.bmp,102,0)
%xl(BackdropB,WpsBackdropB.bmp,102,179)
%xl(PlayerFallback,PlayerFallback.bmp,102,8)
#-- Volume Slider Overlay --#
%xl(VolumeBackdrop,VolumeBackdrop.bmp)
%xl(VolumeIcons,VolumePromptIcons.bmp,4)
%xl(VolumeSliderBackdrop,VolumeSliderBackdrop.bmp)
%xl(VolumeSliderEnd,VolumeSliderEnd.bmp)
#--- Lockscreen Images ---#
%xl(Lockscreen,Wallpaper.bmp)
%xl(AODBackdrop,AODBackdrop.bmp)
%xl(LockPlayIcon,NotifPlayIcon.bmp,2)
%xl(NotificationMusic,NotifMusic.bmp,16,14)
%xl(NotificationBackdrop,Notification.bmp,19,176)
#
#------------ Background Layer ------------#
%V(0,0,-,-,-)%VB
%Cl(102,8,171,171)
# Logic order: Lockscreen Preference -> Lockscreen Style Preference -> Album Art logic
%?if(%St(battery display), =, graphic)<%?mh<%?if(%St(backlight on button hold), =, off)<%xd(AODBackdrop)%dr(0,0,-,-)|%xd(Lockscreen)%?mp<|%xd(NotificationBackdrop)>>|%dr(0,231,-,1,4a494a)%Cd%?C<%xd(BackdropL)%xd(BackdropR)%xd(BackdropT)%xd(BackdropB)|%xd(PlayerFallback)>>|%dr(0,231,-,1,4a494a)%Cd%?C<%xd(BackdropL)%xd(BackdropR)%xd(BackdropT)%xd(BackdropB)|%xd(PlayerFallback)>>
#
#------------ Foreground Layer ------------#
%V(0,0,-,-,-)
%?if(%St(battery display), =, graphic)<%?if(%St(backlight on button hold), !=, off)<%?mh<%Vd(Lockscreen)>>>
%?if(%St(battery display), =, graphic)<%?if(%St(backlight on button hold), =, off)<%?mh<%Vd(AlwaysOnDisplay)>>>
#-- Refresh Song info after volume pop-up --#
%?if(%St(battery display), =, graphic)<%?mh<|%Vd(Player)%?mv(1.5)<%Vd(info)|%Vd(info)>>|%Vd(Player)%?mv(1.5)<%Vd(info)|%Vd(info)>>
#-- Choose the right sized slider based on the total playtime --#
%?if(%St(battery display), =, graphic)<%?mh<|%?if(%pt, >=, 36000)<%Vd(Playtime6Digits)|%?if(%pt, >=, 3600)<%Vd(Playtime5Digits)|%?if(%pt, >=, 600)<%Vd(Playtime4Digits)|%Vd(Playtime3Digits)>>>>|%?if(%pt, >=, 36000)<%Vd(Playtime6Digits)|%?if(%pt, >=, 3600)<%Vd(Playtime5Digits)|%?if(%pt, >=, 600)<%Vd(Playtime4Digits)|%Vd(Playtime3Digits)>>>>
#
#-- Icon Stuff --#
%Vl(Player,75,5,19,21,-)%?mh<%xd(HoldIcon,%mh)|%xd(SleepIcon,%bs)>
%Vl(Player,92,5,19,21,-)%?mh<%xd(SleepIcon,%bs)|>
%Vl(Player,59,5,19,21,-)%xd(PlayIcon,%mp)
%Vl(Player,300,5,16,21,-)%?bp<%xd(ChargingIcon,%bl)|%xd(BatteryIcon,%bl)>
#
%Vl(Player,284,5,19,21,-)
%?lh<%t(0.1)%xd(La);%t(0.1)%xd(Lb);%t(0.1)%xd(Lc);%t(0.1)%xd(Ld);%t(0.1)%xd(Le);%t(0.1)%xd(Lf);%t(0.1)%xd(Lg);%t(0.1)%xd(Lh);%t(0.1)%xd(Li);%t(0.1)%xd(Lj);%t(0.1)%xd(Lk);%t(0.1)%xd(Ll)>
#
#-- Album Art --#
%Vl(Player,102,8,171,195,-)
# If Set to Numerical, turn off rounded corners #
%?if(%St(volume display), =, graphic)<%?C<%xd(TLoverlay)%xd(TRoverlay)%xd(BLoverlay)%xd(BRoverlay)>>
#
#-- Song Info --#
%Vl(Player,12,203,351,37,7)
%s%ac%?it<%it|%fn>
#
#-- Toggle the Secondary info according to user preference --#
%Vl(info,12,231,351,28,6)
%s%ac%?it<%?if(%St(statusbar), =,off)<%t(6)%ia;%t(6)%id;%t(0)>%?if(%St(statusbar), =,top)<%id>%?if(%St(statusbar), =,bottom)<%ia>|%d(1)>
#
%Vl(Player,60,295,19,19,-)%xd(ShuffleIcon,%ps)
%Vl(Player,297,293,20,21,-)%xd(RepeatIcon,%mm)
#
# If playtime is too large, pick a smaller slider size #
%Vl(Playtime3Digits,18,268,38,21,3)
%ar%pc
%Vl(Playtime3Digits,60,271,255,19,-)
%pb(0,0,255,16,Slider.bmp,slider,PlayerSlider,backdrop,SliderBackdrop3Digits)
%Vl(Playtime3Digits,319,268,38,21,3)
%al%pt
#
%Vl(Playtime4Digits,18,268,46,21,3)
%ar%pc
%Vl(Playtime4Digits,68,271,239,19,-)
%pb(0,0,239,16,Slider.bmp,slider,PlayerSlider,backdrop,SliderBackdrop4Digits)
%Vl(Playtime4Digits,311,268,46,21,3)
%al%pt
#
%Vl(Playtime5Digits,18,268,58,21,3)
%ar%pc
%Vl(Playtime5Digits,80,271,215,19,-)
%pb(0,0,215,16,Slider.bmp,slider,PlayerSlider,backdrop,SliderBackdrop5Digits)
%Vl(Playtime5Digits,299,268,58,21,3)
%al%pt
#
%Vl(Playtime6Digits,18,268,66,21,3)
%ar%pc
%Vl(Playtime6Digits,88,271,199,19,-)
%pb(0,0,199,16,Slider.bmp,slider,PlayerSlider,backdrop,SliderBackdrop6Digits)
%Vl(Playtime6Digits,291,268,66,21,3)
%al%pt
#
%Vl(info,280,181,19,21,-)
%?or(%if(%fc, =, 4),%if(%fc, =, 5),%if(%fc, =, 7),%if(%fc, =, 11),%if(%fc, =, 13))<%xd(LosslessIcon)>
#
%Vl(info,76,181,19,21,-)
%?if(%ss(0, 8, %iC), =,explicit)<%xd(ExplicitIcon)>
#
%Vl(info,40,291,146,24,5)%Vf(BDBABD)%?if(%pe, !=, 1)<%ar%pp %Sx(of)>
%Vl(info,190,291,140,24,5)%Vf(BDBABD)
%?if(%pe, !=, 1)<%al%pe>
#--- Volume Overlay ---#
%?mv(1.2)<%Vd(volume)|>
%Vl(volume,82,247,211,60,-)%xd(VolumeBackdrop)
%Vl(volume,98,263,28,28,-)
%?if(%pv, =, -90)<%xd(VolumeIcons,1)>
%?and(%if(%pv, <=, -60),%if(%pv, >, -90))<%xd(VolumeIcons,2)>
%?and(%if(%pv, <=, -30),%if(%pv, >, -60))<%xd(VolumeIcons,3)>
%?if(%pv, >, -30)<%xd(VolumeIcons,4)>
%Vl(volume,136,273,137,7,-)
%?if(%pv, =, -90)<%xd(VolumeSliderBackdrop)|%pv(0,0,137,6,VolumeSlider.bmp,slider,VolumeSliderEnd,backdrop,VolumeSliderBackdrop)>
#
#------------ Lockscreen Layer ------------#
%Vl(Lockscreen,0,0,-,-,-)
%Vl(LockRefresh,5,40,205,276,-)
%Vl(Lockscreen,59,5,19,21,-)%xd(SleepIcon,%bs)
%Vl(Lockscreen,300,5,16,21,-)%?bp<%xd(ChargingIcon,%bl)|%xd(BatteryIcon,%bl)>
%Vl(Lockscreen,284,5,19,21,-)
%?lh<%t(0.1)%xd(La);%t(0.1)%xd(Lb);%t(0.1)%xd(Lc);%t(0.1)%xd(Ld);%t(0.1)%xd(Le);%t(0.1)%xd(Lf);%t(0.1)%xd(Lg);%t(0.1)%xd(Lh);%t(0.1)%xd(Li);%t(0.1)%xd(Lj);%t(0.1)%xd(Lk);%t(0.1)%xd(Ll)>
#
%Vl(Lockscreen,13,43,349,73,8)%ac%?cf<%cH:%cM|%cl:%cM %cP>
%Vl(Lockscreen,4,135,367,27,4)%ac%?if(%ss(0,7,%St(lang)), =, english)<%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>|%ca> %?or(%if(%ss(0,7,%St(lang)), =, chinese),%if(%St(lang), =, magyar),%if(%St(lang), =, lietuviu),%if(%St(lang), =, japanese),%if(%St(lang), =, korean))<%cb %cd|%?if(%St(lang), =, english-us)<%cb %cd|%cd %cb>>
#
#---Notification---#
%Vl(Lockscreen,29,200,317,100,-)%xd(NotificationMusic)
%Vl(Lockscreen,306,240,14,19,-)%?mp<|%xd(LockPlayIcon,1)|%xd(LockPlayIcon,2)|>
%Vl(Lockscreen,109,217,185,27,5)%s%al%?it<%it|%fn>
%Vl(Lockscreen,109,244,185,29,4)
%s%al%?it<%?if(%St(statusbar), =,off)<%t(6)%ia;%t(6)%id;%t(0)>%?if(%St(statusbar), =,top)<%id>%?if(%St(statusbar), =,bottom)<%ia>|%d(1)>
#
#------------ Always on Display ------------#
%Vl(AlwaysOnDisplay,0,0,-,-,-)
%Vl(AlwaysOnDisplay,59,5,19,21,-)%xd(SleepIconAOD,%bs)
%Vl(AlwaysOnDisplay,269,5,16,21,-)%Vf(000000)%?bp<%xd(ChargingIconAOD,%bl)|%xd(BatteryIconAOD,%bl)>
%Vl(AlwaysOnDisplay,271,4,42,23,5)%Vf(000000)
%?or(%if(%bl, <, 22),%if(%bl, =, 31),%if(%bl, =, 41),%if(%bl, =, 51),%if(%bl, =, 61),%if(%bl, =, 71),%if(%bl, =, 81),%if(%bl, =, 91))<%ac|%al>%?if(%bl, =, 100)<CGD|%bl%%>
#
%Vl(AlwaysOnDisplay,286,5,19,21,-)
%?lh<%t(0.1)%xd(Ia);%t(0.1)%xd(Ib);%t(0.1)%xd(Ic);%t(0.1)%xd(Id);%t(0.1)%xd(Ie);%t(0.1)%xd(If);%t(0.1)%xd(Ig);%t(0.1)%xd(Ih);%t(0.1)%xd(Ii);%t(0.1)%xd(Ij);%t(0.1)%xd(Ik);%t(0.1)%xd(Il)>
#
%Vl(AlwaysOnDisplay,13,43,349,73,8)%Vf(000000)%ac%?cf<%cH:%cM|%cl:%cM %cP>
%Vl(AlwaysOnDisplay,4,135,367,27,4)%Vf(000000)%ac%?if(%ss(0,7,%St(lang)), =, english)<%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>|%ca> %?or(%if(%ss(0,7,%St(lang)), =, chinese),%if(%St(lang), =, magyar),%if(%St(lang), =, lietuviu),%if(%St(lang), =, japanese),%if(%St(lang), =, korean))<%cb %cd|%?if(%St(lang), =, english-us)<%cb %cd|%cd %cb>>
#
%Vl(AlwaysOnDisplay,12,217,351,27,5)%Vf(000000)%s%ac%?it<%it|%fn>
%Vl(AlwaysOnDisplay,12,244,351,29,4)%Vf(000000)
%s%ac%?it<%?if(%St(statusbar), =,off)<%t(6)%ia;%t(6)%id>%?if(%St(statusbar), =,top)<%id>%?if(%St(statusbar), =,bottom)<%ia>|%d(1)>
