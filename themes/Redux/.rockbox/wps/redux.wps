#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(wpsbackdrop-320x240x16.bmp)
#
# Preload Images
%xl(A,lock-320x240x16.bmp,0,0)
%xl(B,battery-320x240x16.bmp,0,0,10)
%xl(C,volume-320x240x16.bmp,0,0,6)
%xl(D,shuffle-320x240x16.bmp,248,261)
%xl(E,repeat-320x240x16.bmp,0,0,4)
%xl(F,playmode-320x240x16.bmp,0,0,5)
%xl(G,pk-320x240x16.bmp,0,0)
%xl(H,vk-320x240x16.bmp,0,0)
%xl(K,repeat-labels-320x240x16.bmp,0,0,4)
%xl(u,vu1s.bmp,0,0) 
%xl(v,vu2s.bmp,0,0)
%xl(w,vu1s2.bmp,0,0)
%xl(x,vu2s2.bmp,0,0)
%xl(y,vu1s3.bmp,0,0)
%xl(z,vu2s3.bmp,0,0)
#
# Load Fonts
%Fl(5,24-Arimo-Bold.fnt)
%Fl(6,09-Nedore.fnt)
%Fl(7,15-Adobe-Helvetica.fnt)
#
# Album Art/Info Viewport Conditional (not using this)
%Vd(a)
#%?C<%Vd(a)|%Vd(b)>
#
# If volume changed, display volume bar, else display progress bar and elapsed / remaining times 
%?mv(.5)<%Vd(g)|%Vd(d)%Vd(f)>
#
# Viewport d: Display progress bar
%Vl(d,172,147,161,24,-)
%pb(0,0,161,24,pb-320x240x16.bmp,slider,G)
#
# Viewport g: Display volume bar
%Vl(g,172,147,161,24,-)%Vf(000000)
%pv(0,0,161,24,vb-320x240x16.bmp,slider,H)
#
#
#-------------STATUS BAR-------------
# Battery Numeric
%V(306,35,18,13,6)%Vf(BBBBBB)
%ar%bl
# Battery Image
%V(326,36,14,9,-)
%?bp<%?bc<%xd(Ba)|%xd(Bb)>|%?bl<|%xd(Bc)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)>>
#
# Volume Numeric
%V(253,35,18,13,6)%Vf(BBBBBB)
%ar%pv
# Volume
%V(274,36,23,9,-)
%?pv<%xd(Ca)|%xd(Cb)|%xd(Cc)|%xd(Cd)|%xd(Ce)|%xd(Cf)>
#
%xl(g,lock-320x240x16.bmp,0,0)
%V(237,36,8,9,-)
%?mh<%xd(g)|>
#-------------END STATUS BAR-------------
#
# Shuffle
%V(248,261,54,41,-)
%?ps<%xd(D)>
#
# Repeat
%V(285,261,57,41,-)
%?mm<|%xd(Ea)|%xd(Eb)|%xd(Ec)|%xd(Ed)>
#
# Repeat Label
%V(294,169,33,7,-)
%?mm<|%xd(Ka)|%xd(Kb)|%xd(Kc)|%xd(Kd)>
#
# Playmode
%V(34,261,213,41,-)
%?mp<%xd(Fa)|%xd(Fb)|%xd(Fc)|%xd(Fd)|%xd(Fe)>
#
# Track # of #
%V(284,211,61,24,7)
%ac%?Sr<%pe %Sx(of) %pp|%pp %Sx(of) %pe>
#
# Time Elapsed
%V(41,201,53,33,5)%Vf(FFFFFF)
%ac%pc
# Time Remaining
%V(105,211,35,24,7)%Vf(949494)
%al%pt
#
# Album Art
%ax
%Vl(a,41,47,111,127,-)
%Cl(0,0,111,127,c,c)
%Cd
#
# Track Info - Album Art
%ax
%Vl(a,200,117,132,21,7)
%Vf(52a1fe)
%s%al%?it<%it|%fn>
#
%ax
%Vl(a,200,56,132,21,7)
%Vf(52a1fe)
%s%al%?ia<%ia|%?d(2)<%d(2)|%(root%)>>
#
# Track Title
%ax
%Vl(a,200,87,132,21,7)
%Vf(ffffff)
%s%al%?id<%id|%?d(1)<%d(1)|%(root%)>>
#
%ax
%Vl(b,200,117,130,21,7)
%Vf(52a1fe)
%s%al%?it<%it|%fn>
#
%ax
%Vl(b,200,56,132,21,7)
%Vf(52a1fe)
%s%al%?ia<%ia|%?d(2)<%d(2)|%(root%)>>
#
%ax
%Vl(b,200,87,132,21,7)
%Vf(ffffff)
%s%al%?id<%id|%?d(1)<%d(1)|%(root%)>>
