# WPS File
#

# Hide The Status Bar
%wd

# Load Backdrop
%X(wps_backdrop.bmp)

# Preload Fonts
%Fl(2,14-Ubuntu-M.fnt)
%Fl(3,18-Cantarell-Bold.fnt)
%Fl(4,14-Rockbox-Mix.fnt)

# Preload Images
#%xl(A,aa.bmp,0,0)
%xl(B,battery.bmp,0,0,24)
%xl(C,pb.bmp,0,0)
%xl(D,pb_back.bmp,0,0)
%xl(E,ps.bmp,0,0)
%xl(F,pbl.bmp,0,0)
%xl(G,pbr.bmp,306,0)
%xl(H,play_pause.bmp,0,0,3)
%xl(I,seek.bmp,0,0,4)
%xl(J,mute.bmp,0,0,2)
%xl(K,vol.bmp,0,0)
%xl(L,vol_back.bmp,0,0)
%xl(M,Shuffle Icon - SBS.bmp,0,0)
%xl(N,Playback Icons - WPS.bmp,0,0,5)
%xl(O,Hold Icon - SBS.bmp,0,0)

# Album Art Settings(align center center)
%Cl(0,0,141,141,c,c)
# Album Art
%V(35,66,141,147,-)
%?C<%Cd>

# Battery
%V(326,35,20,11,-)
%?bp<%?bc<%t(1.0)%xd(Ba);%t(1.0)%xd(Bb)|%xd(Bc)>|%?bl<%xd(Bd)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)|%xd(Bp)|%xd(Bq)|%xd(Br)|%xd(Bs)|%xd(Bt)|%xd(Bu)|%xd(Bv)|%xd(Bw)|%xd(Bx)>>#


# Battery text
%V(288,34,33,16,2)%Vf(F4F4F4)%Vb(000000)
%ar%bl%%
#

#-- Hold Icon
%V(27,35,7,11,-)%Vf(F4F4F4)%Vb(000000)
%?mh<%xd(O)|%?mr<%xd(O)>>


#-- Date Bar
%V(125,34,125,16,2)%Vf(F4F4F4)%Vb(000000)
%ac%cb %ce, %?cf<%cH:%cM|%cl:%cM>

# Artist
%V(188,91,159,19,4)#%Vf(F4F4F4)
%al%s%?ia<%ia|%?d(2)<%d(2)|%Sx(Artist)>>
# Title
%V(189,62,159,22,3)#%Vf(F4F4F4)
%al%s%?it<%s%it|%fn>
# Album
%V(188,108,159,20,4)#%Vf(F4F4F4)
%al%s%?id<%id|%?d(1)<%d(1)|%Sx(Album)>>
# Year
%V(186,125,160,20,4)#%Vf(F4F4F4)
%al%?iy<%iy>
# Song Number In Playlist
%V(188,154,51,14,2)
%al%pp/%pe


# Track Information
%V(188,186,159,20,2)%Vf(F4F4F4)
%s%al%fc
%V(188,203,159,20,2)%Vf(F4F4F4)
%s%al%fb kbps %(%?fv<vbr|cbr>%)


# Song Current Time
%V(35,218,59,16,2)
%al%pc
# Song Remaining Time
%V(281,218,59,16,2)
%ar%pt

# Progress Bar
# With a little hacking to make border look nice
%V(33,237,309,12,-)
%xd(F)
%pb(2,0,304,11,C,backdrop,D,slider,E)
%xd(G)

# Seek Back
%V(41,268,12,12,-)
%?mp<%xd(Ia)|%xd(Ia)|%xd(Ia)|%xd(Ia)|%xd(Ib)>
# Play Pause
%V(59,268,13,12,-)
%?mp<%xd(Hc)|%xd(Ha)|%xd(Hb)|%xd(Ha)|%xd(Ha)>
# Seek Forward
%V(77,268,12,12,-)
%?mp<%xd(Ic)|%xd(Ic)|%xd(Ic)|%xd(Id)|%xd(Ic)>

# Repeat
%V(177,267,15,13,-)
%xd(N, %mm)
# %?mm<%xd(Na)|%xd(Nb)|%xd(Nb)|%xd(Nb)|%xd(Nb)>

# Shuffle
%V(196,267,14,13,-)
%?ps<%xd(M)>

# Mute
%V(214,267,15,14,-)
%?pv<%xd(Jb)|%xd(Ja)|%xd(Ja)|%xd(Ja)>

# Volume
# With a little hacking to make border look nice
%V(235,268,107,12,-)
%pv(2,0,102,11,K,backdrop,L,slider,E)