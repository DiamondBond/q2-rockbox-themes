###############################################################
#
# WPS File
#
#-- Hide The Status Bar
%wd
#
#-- Load Backdrop
%X(backdrop-wps.bmp)
#
#-- Preload Fonts
%Fl(5,16-Inter-SemiBold.fnt)
%Fl(6,18-Inter-SemiBold.fnt)
%Fl(7,20-Inter-SemiBold.fnt)
%Fl(8,26-Inter-Bold.fnt)
#
#-- Preload Images
%xl(B,disk.bmp,0,0,6)
%xl(C,pb.bmp,0,0)
%xl(D,pb_back.bmp,0,0)
%xl(E,battery.bmp,0,0,25)
%xl(G,volume.bmp,0,0,21)
%xl(H,status.bmp,0,0,4)
%xl(M,shuffle.bmp,0,0)
%xl(N,repeat.bmp,0,0,4)
%xl(O,hold.bmp,0,0)
%xl(P,lossless.bmp,0,0)
%xl(w,cornerTL.bmp,0,0)
%xl(x,cornerTR.bmp,143,0)
%xl(y,cornerBL.bmp,0,163)
%xl(z,cornerBR.bmp,143,163)
#
##############
# STATUS BAR #
##############
#
#-- Status icons
%V(46,11,27,20,-)%Vf(ffffff)%Vb(F4F4F4)
%?mp<|%xd(Ha)|%xd(Hb)|%xd(Hc)|%xd(Hd)||||>
#
#-- Disk working
%V(35,18,19,21,-)
%?lh<%t(0.1)%xd(Ba);%t(0.1)%xd(Bb);%t(0.1)%xd(Bc);%t(0.1)%xd(Bd);%t(0.1)%xd(Be);%t(0.1)%xd(Bf)>
#
#-- Hold icon
%V(61,11,15,20,-)%Vf(ffffff)%Vb(F4F4F4)
%?mh<%xd(O)|%?mr<%xd(O)>>
#
#-- Status title
%V(117,9,141,21,6)%Vf(ffffff)%Vb(F4F4F4)
#%ac%cb %ce%, %?cf<%cH:%cM|%cl:%cM %cP>
%s%ac%?pS(15)<Now Playing|%?cf<%cH:%cM|%cl:%cM %cP>>
#
#-- Battery percentage
%V(286,9,38,21,6)%Vf(ffffff)%Vb(F4F4F4)
%ar%bl%%
#
#-- Battery icon top right
%V(327,43,36,20,-)%Vf(ffffff)%Vb(F4F4F4)
%?bp<%?bc<%?bl<%xd(Ex)|%xd(Ew)|%xd(Ev)|%xd(Eu)|%xd(Et)|%xd(Es)|%xd(Er)|%xd(Eq)|%xd(Ep)|%xd(Eo)|%xd(En)|%xd(Em)>|%xd(Ey)>|%?bl<%xd(El)|%xd(Ek)|%xd(Ej)|%xd(Ei)|%xd(Eh)|%xd(Eg)|%xd(Ef)|%xd(Ee)|%xd(Ed)|%xd(Ec)|%xd(Eb)|%xd(Ea)>>
#
###########
# CONTENT #
###########
#
#-- Album art
%Cl(0,0,159,181)
# Album Art
%V(15,40,159,181,-)
#%?C<%Cd>
#
#-- Album art round corners
%?mh<%Cd%?C<%xd(w)%xd(x)%xd(y)%xd(z)|>|%Cd%?C<%xd(w)%xd(x)%xd(y)%xd(z)|>> #refresh art on Hold
#
#-- Title
%V(191,80,169,40,8)%Vf(ffffff)
%al%s%?it<%s%it|%fn>
#
#-- Artist
%V(191,120,169,33,7)%Vf(ffffff)
%al%s%?ia<%ia|%?d(2)<%d(2)|%Sx(Artist)>>
#
#-- Lossless
# determine if 'lossless', aiff=4, wave=5, flac=7, alac=11, shorten=13
%?or(%if(%fc, =, 4),%if(%fc, =, 5),%if(%fc, =, 7),%if(%fc, =, 11),%if(%fc, =, 13))<%Vd(lossless)>
#-- Lossless Indicator Image
%Vl(lossless,190,168,74,23,-)
%Vb(fffffff)
%xd(P)
#
#-- File details
%V(191,193,169,24,5)%Vf(ffffff)
%fc, %fbkbps %fkkhz
#
#-- Progress Bar
# With a little hacking to make border look nice
%V(15,241,345,7,0)
%pb(0,0,345,7,D,backdrop,C)
#
#-- Song Current Time
%V(15,251,67,21,5)
%al%pc
#
#-- Song Remaining Time
%V(292,251,67,21,5)
%ar-%pr
#
#-- Volume
%V(112,265,42,48,-)
%?mv(1.0)<%?pv<%xd(Ga)|%xd(Gb)|%xd(Gc)|%xd(Gd)|%xd(Ge)|%xd(Gf)|%xd(Gg)|%xd(Gh)|%xd(Gi)|%xd(Gj)|%xd(Gk)|%xd(Gl)|%xd(Gm)|%xd(Gn)|%xd(Go)|%xd(Gp)|%xd(Gq)|%xd(Gr)|%xd(Gs)|%xd(Gt)|%xd(Gu)>>
#
#-- Repeat
%V(169,276,30,27,-)
%?mm<|%xd(Na)|%xd(Nb)|%xd(Nc)|%xd(Nd)>
#
#-- Shuffle
%V(224,276,30,27,-)
%?ps<%xd(Ma)>
#