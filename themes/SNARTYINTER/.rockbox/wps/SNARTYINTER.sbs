%?and(%if(%pv, <=, -60),%if(%pv, >, -90))<%xd(VolumeIcons,2)>
%?and(%if(%pv, <=, -30),%if(%pv, >, -60))<%xd(VolumeIcons,3)>
%?if(%pv, >, -30)<%xd(VolumeIcons,4)>
%Vl(Quickscreen,72,111,254,13,-)%pv(0,0,254,12,Slider,backdrop,SliderBack)
%Vl(Quickscreen,49,135,27,29,-)%xd(BrightnessIcons,1)
