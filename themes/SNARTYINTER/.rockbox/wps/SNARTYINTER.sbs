#__USB Screen
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(USB)|%VI(menuViewport)%Vd(MainDisplay)%?pE(15)<%?mp<|%Vd(nextInfo)>|%Vd(curInfo)>>

