#----------- Quick Screen Layer -----------#

#--- Clear Screen ---#
%V(0,0,375,320,-)

#--- Quick Screen Default Location ---#
%?if(%cs, =, 10)<%Vd(Quickscreen)%VI(QuickDefault)>

#--- Quick Screen Sliders ---#
%Vl(Quickscreen,49,110,16,15,-)
